#!/usr/bin/env bash
# rsync-hub — coleta CARBONARA por rsync-over-SSH: o lado HOST (servidor central).
#
# Papéis deste arquivo:
#   1) Instalação guiada — `install` conduz passo a passo: pasta raiz dos dados, conta
#      de serviço e, na sequência, a autorização das estações (clientes).
#   2) Gerência   — autoriza/remove/lista estações (menu interativo ou comando direto).
#   3) Monitor    — modo que fica rodando mostrando quem conectou e o que chegou.
#      Inclui a PAUSA da recepção (`pause`/`resume`): suspende a chegada de dados sem
#      revogar credenciais nem apagar nada — útil em manutenção do servidor.
#   4) Comando forçado — cada estação, ao conectar por SSH, cai em `rsync-hub serve <id>`,
#      que confina o rsync à pasta daquela estação (write-only).
#
# O lado CLIENTE (estações Linux/Windows) fica em collection/station/carbonara-station.sh e
# collection/station/carbonara-station.ps1 — assistentes guiados que geram a chave, testam e
# agendam o envio. Rode `rsync-hub cliente` para ver as instruções passo a passo.
#
# Isolamento (simples, mas real): cada estação tem uma CHAVE que só executa este script
# com o SEU id; o `restrict` no authorized_keys corta shell/túnel/PTY; e o `rrsync -wo`
# tranca o rsync na pasta da estação, em modo só-escrita (envia, não baixa nem lê as
# outras). Uma conta de serviço única dona das pastas — sem criar usuário por estação.
#
# Uso:
#   sudo ./rsync-hub install             # instalação GUIADA do host (pastas+conta+estações)
#   sudo ./rsync-hub install --defaults  # instalação sem perguntas (usa defaults/ambiente)
#   sudo ./rsync-hub add <id>            # autoriza GERANDO a chave aqui (stations/<id>/
#                                        #   guarda o par + INSTRUCOES.txt de ativação)
#   sudo ./rsync-hub add <id> <pub>      # autoriza com chave pública já existente
#   sudo ./rsync-hub add <id> --senha    # autoriza por USUÁRIO+SENHA (rsync daemon:873;
#                                        #   simples no cliente, dados sem criptografia)
#   sudo ./rsync-hub pause <id>          # PAUSA a recepção de dados dessa estação
#   sudo ./rsync-hub pause --todas [mot] # PAUSA a recepção de TODAS as estações
#   sudo ./rsync-hub resume <id|--todas> # RETOMA a recepção pausada
#   sudo ./rsync-hub remove <id>         # revoga o acesso da estação (dados preservados)
#   sudo ./rsync-hub purge <id>          # EXCLUI definitivamente (acesso + TODOS os dados)
#   sudo ./rsync-hub move-root <novo>    # MIGRA a raiz inteira (dados+chaves+conf) para
#                                        #   outra pasta; a antiga fica como cópia de segurança
#        ./rsync-hub list                # lista estações autorizadas
#        ./rsync-hub monitor             # fica rodando, mostrando as conexões (Ctrl-C sai)
#        ./rsync-hub status              # mostra o status uma vez
#        ./rsync-hub cliente             # como configurar uma estação (cliente)
#        ./rsync-hub                     # abre o menu interativo
#
# Configuração: o `install` grava as escolhas em /etc/rsync-hub.conf; variáveis de
# ambiente (CARBONARA_ROOT, HUB_USER, RRSYNC) têm precedência sobre o arquivo.
set -eu

# Bump a cada mudança de comportamento — é como se detecta uma cópia instalada
# defasada em /usr/local/bin (compare `rsync-hub help` com o script do repositório).
RSYNC_HUB_VERSION="2026-08-25.1"

# --- Configuração: defaults ← /etc/rsync-hub.conf ← ambiente ---------------------
ENV_BASE="${CARBONARA_ROOT:-}"; ENV_HUB_USER="${HUB_USER:-}"; ENV_RRSYNC="${RRSYNC:-}"
CONF_FILE="${RSYNC_HUB_CONF:-/etc/rsync-hub.conf}"
BASE=""; HUB_USER=""; RRSYNC=""
[ -r "$CONF_FILE" ] && . "$CONF_FILE"
BASE="${ENV_BASE:-${BASE:-/srv/carbonara}}"          # raiz dos dados no host
HUB_USER="${ENV_HUB_USER:-${HUB_USER:-carbonara}}"   # conta de serviço única que recebe os envios
RRSYNC="${ENV_RRSYNC:-${RRSYNC:-/usr/bin/rrsync}}"   # wrapper restrito que acompanha o rsync
REFRESH="${RSYNC_HUB_REFRESH:-3}"                    # segundos entre atualizações do monitor
STALE_AFTER="${RSYNC_HUB_STALE:-3600}"               # sem atividade > isto (s) => estação "MUDA"
SELF=""                                              # caminho a gravar no authorized_keys (ver install)

RSYNCD_PORT="${RSYNCD_PORT:-873}"            # porta do modo usuário+senha (rsync daemon)

derive_paths() {
    INCOMING="$BASE/incoming"                # uma subpasta por estação
    LOG="$BASE/log/connections.log"          # registro de conexões (texto simples)
    AUTHKEYS="$BASE/.ssh/authorized_keys"    # chaves das estações (fora do alcance delas)
    RSYNCD_CONF="$BASE/rsyncd.conf"          # módulos do modo usuário+senha (gerado)
    RSYNCD_SECRETS="$BASE/rsyncd.secrets"    # credenciais id:senha (644, fonte da verdade)
    RSYNCD_LOG="$BASE/log/rsyncd.log"
    PAUSE_DIR="$BASE/pause"                  # marcadores de PAUSA da recepção
    PAUSE_ALL="$PAUSE_DIR/_todas"            # pausa global (vale para todas as estações)
}
derive_paths

die()      { echo "erro: $*" >&2; exit 1; }
need_root(){ [ "$(id -u)" = 0 ] || die "execute como root (sudo)"; }
is_root()  { [ "$(id -u)" = 0 ]; }
is_tty()   { [ -t 0 ] && [ -t 1 ]; }
valid_id() { echo "$1" | grep -Eq '^[a-z0-9][a-z0-9_]{1,30}$' \
                || die "id inválido: '$1' (use minúsculas, dígitos e '_')"; }
self_path(){ [ -n "$SELF" ] && { echo "$SELF"; return; }
             readlink -f "$0" 2>/dev/null || echo "$0"; }
host_addr(){ hostname -I 2>/dev/null | awk 'NF{print $1; exit}' | grep . || hostname; }

ask() { # $1=pergunta $2=default → ecoa a resposta (Enter aceita o default)
    if [ -n "${2:-}" ]; then printf '%s [%s]: ' "$1" "$2" >&2; else printf '%s: ' "$1" >&2; fi
    read -r a || a=""
    if [ -n "$a" ]; then printf '%s\n' "$a"; else printf '%s\n' "${2:-}"; fi
}
# Substituição SEGURA de arquivo de controle (authorized_keys, rsyncd.secrets/conf):
# grava num temporário, CONFERE que a gravação terminou e só então renomeia.
# Motivo (incidente real): com o disco cheio, o padrão antigo
#     grep -v ... > arq.tmp || true ; mv arq.tmp arq
# ZERAVA o arquivo — o `mv` é um rename e não precisa de espaço, então o temporário
# truncado (ou vazio) substituía o bom e TODAS as estações passavam a receber
# "Permission denied (publickey)". Agora, se não couber, o arquivo original fica.
write_replace() {   # $1=destino; o conteúdo novo vem do STDIN. rc 0 = trocado.
    wr_dst="$1"; wr_tmp="$wr_dst.novo.$$"
    if cat > "$wr_tmp"; then
        if mv "$wr_tmp" "$wr_dst"; then return 0; fi
    fi
    rm -f "$wr_tmp" 2>/dev/null || true
    return 1
}
disk_hint() {  # mensagem de erro padrão de gravação (a causa quase sempre é espaço)
    echo "falha ao gravar $1 — o arquivo anterior foi PRESERVADO."
    echo "espaço em disco (a causa mais comum):"
    df -h "$BASE" 2>/dev/null | sed 's/^/    /' || true
}

ask_yn() { # $1=pergunta $2=default (s|n) → rc 0 = sim
    d="${2:-s}"
    if [ "$d" = s ]; then h="S/n"; else h="s/N"; fi
    printf '%s [%s]: ' "$1" "$h" >&2
    read -r a || a=""
    a="${a:-$d}"
    case "$a" in s|S|y|Y|sim|Sim|SIM) return 0 ;; *) return 1 ;; esac
}

# --- Papel 4: comando forçado (o sshd chama isto; não é para uso manual) ---------
serve() {
    station="${1:-}"; [ -n "$station" ] || exit 1
    ts="$(date -u +%FT%TZ)"; ip="${SSH_CLIENT%% *}"
    # Só aceita rsync em modo servidor; qualquer outra coisa é barrada e registrada.
    case "${SSH_ORIGINAL_COMMAND:-}" in
        "rsync --server "*) : ;;
        *) echo "$ts REJECT $station $ip ${SSH_ORIGINAL_COMMAND:-}" >>"$LOG" 2>/dev/null || true
           echo "rsync-hub: somente rsync (envio) é permitido." >&2; exit 128 ;;
    esac
    # Recepção pausada (global ou desta estação): recusa a sessão ANTES do CONNECT —
    # nada é gravado. O cliente trata rc≠0 como falha, NÃO avança o estado local e
    # reenvia tudo no próximo ciclo: uma pausa não perde dado, só adia.
    if is_paused "$station"; then
        echo "$ts PAUSED $station $ip" >>"$LOG" 2>/dev/null || true
        if [ -f "$PAUSE_ALL" ]; then pfile="$PAUSE_ALL"; else pfile="$PAUSE_DIR/$station"; fi
        echo "rsync-hub: recepção de dados PAUSADA no servidor ($(pause_note "$pfile"))." >&2
        echo "rsync-hub: nada foi enviado — o envio volta sozinho quando o servidor retomar." >&2
        exit 129
    fi
    echo "$ts CONNECT $station $ip" >>"$LOG" 2>/dev/null || true
    rc=0; "$RRSYNC" -wo "$INCOMING/$station" || rc=$?   # -wo = write-only, confinado à pasta
    echo "$(date -u +%FT%TZ) DISCONNECT $station $ip" >>"$LOG" 2>/dev/null || true
    exit "$rc"
}

# --- Papel 1: instalação -----------------------------------------------------------
find_rrsync() {
    for c in "$RRSYNC" /usr/bin/rrsync /usr/local/bin/rrsync; do
        [ -x "$c" ] && { RRSYNC="$c"; return 0; }
    done
    if command -v rrsync >/dev/null 2>&1; then RRSYNC="$(command -v rrsync)"; return 0; fi
    return 1
}

create_host() {   # o miolo do install: conta de serviço + pastas + arquivos
    id "$HUB_USER" >/dev/null 2>&1 || \
        useradd --system --home-dir "$BASE" --create-home --shell /bin/sh "$HUB_USER"
    passwd -l "$HUB_USER" >/dev/null 2>&1 || true      # tranca a senha: só chave
    install -d -m 755 -o "$HUB_USER" -g "$HUB_USER" "$BASE" "$INCOMING" "$BASE/log"
    # .ssh 755 e authorized_keys 644: o sshd (StrictModes) só exige que NÃO sejam
    # graváveis por grupo/outros — leitura aberta é permitida e é a política do host.
    install -d -m 755 -o "$HUB_USER" -g "$HUB_USER" "$BASE/.ssh"
    install -d -m 755 "$BASE/stations" "$PAUSE_DIR"
    touch "$LOG"; chown "$HUB_USER:$HUB_USER" "$LOG"; chmod 644 "$LOG"
    touch "$AUTHKEYS"; chown "$HUB_USER:$HUB_USER" "$AUTHKEYS"; chmod 644 "$AUTHKEYS"
    # Política de LEITURA do host: os usuários locais podem VER tudo (dados, chaves,
    # credenciais/instruções, lista de estações) sem sudo — mas nada é gravável por
    # eles. A segurança de ESCRITA continua valendo para as estações (forced command +
    # rrsync/módulo write-only). Normaliza também instalações antigas:
    chmod -R u+rwX,go+rX "$BASE/stations" 2>/dev/null || true
    if [ -f "$RSYNCD_SECRETS" ]; then
        chmod 644 "$RSYNCD_SECRETS"
        rebuild_rsyncd_conf
    fi
}

save_conf() {     # persiste as escolhas para os próximos usos (inclusive o serve via sshd)
    # Escrita ATÔMICA (tmp + mv na mesma pasta): o serve roda a CADA conexão de
    # estação e faz source deste arquivo — um '>' direto teria uma janela de conf
    # parcial (BASE ausente => defaults errados) bem no meio de um move-root.
    if { echo "# gerado por 'rsync-hub install' em $(date -u +%FT%TZ)"
         echo "BASE=$BASE"
         echo "HUB_USER=$HUB_USER"
         echo "RRSYNC=$RRSYNC"; } > "$CONF_FILE.tmp" 2>/dev/null \
       && chmod 644 "$CONF_FILE.tmp" && mv "$CONF_FILE.tmp" "$CONF_FILE"; then
        echo "configuração gravada em $CONF_FILE."
    else
        rm -f "$CONF_FILE.tmp" 2>/dev/null || true
        echo "aviso: não consegui gravar $CONF_FILE — defina CARBONARA_ROOT/HUB_USER no ambiente."
    fi
}

install_host() {
    need_root
    # Sem terminal (ou com --defaults): comportamento direto, sem perguntas.
    if [ "${1:-}" = "--defaults" ] || ! is_tty; then
        find_rrsync || echo "aviso: 'rrsync' não encontrado — instale o pacote 'rsync'."
        create_host; save_conf
        echo "host preparado: conta '$HUB_USER', pastas em $BASE."
        echo "instale o script no PATH, ex.: sudo install -m 755 $(self_path) /usr/local/bin/rsync-hub"
        return 0
    fi

    echo
    echo "===== Instalação guiada do host (servidor central) ====="
    echo "Este assistente prepara ESTA máquina para receber os dados das estações:"
    echo "  passo 1 — pasta raiz onde os arquivos vão chegar;"
    echo "  passo 2 — conta de serviço (recebe todos os envios; senha travada, só chave);"
    echo "  passo 3 — autorização das estações (clientes) que vão se conectar."
    echo

    # Passo 1/3 — pasta raiz
    echo "--- Passo 1/3: pasta raiz dos dados ---"
    echo "Tudo chega em <raiz>/incoming/<estação>/; a ingestão lê dali."
    while :; do
        b="$(ask "Pasta raiz dos dados" "$BASE")"
        case "$b" in
            /*) BASE="$b"; break ;;
            *)  echo "  use um caminho absoluto (começando com /)." ;;
        esac
    done
    derive_paths
    HUB_USER="$(ask "Conta de serviço (será criada se não existir)" "$HUB_USER")"
    rrsync_txt="$RRSYNC"
    if ! find_rrsync; then
        rrsync_txt="NÃO ENCONTRADO"
        echo "  aviso: 'rrsync' não foi encontrado — ele acompanha o pacote 'rsync' e é"
        echo "         obrigatório para RECEBER os envios (as pastas podem ser criadas já)."
        echo "         instale com: sudo apt-get install rsync   (ou o equivalente da distro)"
        if ! ask_yn "  Continuar mesmo assim (só cria conta e pastas)?" n; then
            echo
            echo "*** INSTALAÇÃO CANCELADA — NADA FOI CRIADO. ***"
            echo "instale o rsync e rode de novo: sudo rsync-hub install"
            return 1
        fi
    else
        rrsync_txt="$RRSYNC"
    fi
    echo
    echo "Resumo: raiz=$BASE · conta=$HUB_USER · rrsync=$rrsync_txt"
    if ! ask_yn "Confirmar e criar?" s; then
        echo
        echo "*** INSTALAÇÃO CANCELADA — NADA FOI CRIADO. ***"
        return 1
    fi
    create_host
    save_conf
    echo "ok: host preparado (conta '$HUB_USER'). Pastas criadas:"
    echo "    $INCOMING    ← os dados chegam aqui (uma subpasta por estação)"
    echo "    $BASE/log    ← registro de conexões"
    echo "    $BASE/.ssh   ← chaves das estações (authorized_keys)"
    echo

    # Passo 2/3 — script no PATH (o authorized_keys aponta para este caminho)
    echo "--- Passo 2/3: instalar o script no PATH ---"
    if [ "$(self_path)" != "/usr/local/bin/rsync-hub" ]; then
        if ask_yn "Copiar para /usr/local/bin/rsync-hub (recomendado)?" s; then
            install -m 755 "$(self_path)" /usr/local/bin/rsync-hub
            SELF="/usr/local/bin/rsync-hub"
            echo "ok: daqui em diante chame apenas 'rsync-hub', de qualquer pasta."
        else
            echo "ok — as chaves das estações vão apontar para $(self_path); não mova o arquivo."
        fi
    else
        echo "já está em /usr/local/bin/rsync-hub."
    fi
    echo

    # Passo 3/3 — autorizar estações
    echo "--- Passo 3/3: autorizar as estações (clientes) ---"
    echo "O mais simples é GERAR a chave de cada estação aqui mesmo (aperte ENTER na"
    echo "pergunta da chave): ela fica em $BASE/stations/<id>/ junto com um"
    echo "INSTRUCOES.txt de ativação — você leva a chave privada para a estação."
    echo "Se a estação já tem chave própria, informe o arquivo .pub ou cole a linha."
    echo "Dá para adicionar estações depois também (sudo rsync-hub add <id>)."
    while ask_yn "Adicionar uma estação agora?" s; do
        add_station_wizard || echo "  (estação não adicionada — tente de novo)"
    done

    echo
    echo "===== Instalação concluída — próximos passos ====="
    echo "  - em cada estação, rode o assistente do cliente apontando para este host:"
    echo "      endereço: $(host_addr) · porta: 22 · conta: $HUB_USER"
    echo "    (instruções completas: rsync-hub cliente)"
    [ "$BASE" != "/srv/carbonara" ] && \
        echo "  - use CARBONARA_ROOT=$BASE no .env do docker compose (mesma raiz da coleta)."
    echo "  - acompanhe as chegadas com: rsync-hub monitor"
}

# --- Papel 2: gerência -------------------------------------------------------------
write_instructions() {  # $1=id $2=pasta da estação — gera o INSTRUCOES.txt de ativação
    wi_id="$1"; wi_dir="$2"; wi_addr="$(host_addr)"
    cat > "$wi_dir/INSTRUCOES.txt" <<EOF
CARBONARA — ativação da estação '$wi_id'
========================================
(gerado por rsync-hub em $(date -u +%FT%TZ))

Servidor (host): $wi_addr · porta: 22 (padrão) · conta: $HUB_USER

1) Copie para a máquina da estação:
     - a chave privada desta pasta:  ${wi_id}_key   (mantenha-a protegida!)
     - o cliente (pasta collection/station/ do repositório carbonara-datahub):
         Linux:    carbonara-station.sh
         Windows:  carbonara-station.ps1 + carbonara-station.cmd

2) Na estação, rode o assistente guiado:
         Linux:    ./carbonara-station.sh setup
         Windows:  .\\carbonara-station.cmd setup
                   (na 1ª vez o assistente instala o rsync (cwRsync) sozinho —
                    abra o PowerShell COMO ADMINISTRADOR só nessa primeira vez)
   Ele pergunta, nesta ordem:
     - id da estação ................ $wi_id
     - IP do host ................... $wi_addr   (porta: 22, se não foi alterada)
     - caminho local da chave ....... onde você salvou o arquivo ${wi_id}_key
     → teste simples de conexão (o host responde? a chave é aceita?)
     - pasta local a enviar (rsync)
     - tempo de reciclagem (minutos) + ativação do envio automático

3) Pronto. Acompanhe as chegadas no servidor com:  rsync-hub monitor

Observações:
  - A chave pública (${wi_id}_key.pub) permanece nesta pasta e já está autorizada.
  - Para revogar o acesso desta estação:  sudo rsync-hub remove $wi_id
EOF
    chmod 644 "$wi_dir/INSTRUCOES.txt"
}

# --- Modo usuário+senha: rsync daemon (porta 873) -----------------------------------
# Alternativa às chaves para estações onde a chave complica: o rsync daemon tem
# autenticação própria (usuário=id da estação, senha desafio-resposta — a senha não
# trafega em claro) e cada estação vira um módulo confinado à sua pasta, write-only e
# com --delete recusado. ATENÇÃO: os DADOS trafegam sem criptografia — para redes
# públicas, prefira o modo chave SSH.
gen_password() { LC_ALL=C tr -dc 'a-z0-9' </dev/urandom | head -c 12; }

rebuild_rsyncd_conf() {   # regenera o rsyncd.conf inteiro a partir do secrets
    {
        echo "# gerado por rsync-hub em $(date -u +%FT%TZ) — NÃO edite (regenerado no add/remove)"
        echo "uid = $HUB_USER"
        echo "gid = $HUB_USER"
        echo "use chroot = true"
        # strict modes = false: permite o rsyncd.secrets 644 (política de leitura
        # aberta do host — sem isso o daemon recusa um secrets legível por todos).
        echo "strict modes = false"
        echo "pid file = $BASE/rsyncd.pid"
        echo "lock file = $BASE/rsyncd.lock"
        echo "log file = $RSYNCD_LOG"
        echo "port = $RSYNCD_PORT"
        while IFS=: read -r sid _; do
            [ -n "$sid" ] || continue
            # Recepção pausada: o módulo simplesmente não é gerado. O rsyncd relê a
            # config a cada conexão, então a pausa vale na hora (o cliente recebe
            # "unknown module") e a senha continua guardada no secrets, intacta.
            if is_paused "$sid"; then
                echo
                echo "# [$sid] — recepção PAUSADA (marcador em $PAUSE_DIR); módulo omitido"
                continue
            fi
            echo
            echo "[$sid]"
            echo "    path = $INCOMING/$sid"
            echo "    comment = estacao CARBONARA $sid (write-only)"
            echo "    auth users = $sid"
            echo "    secrets file = $RSYNCD_SECRETS"
            echo "    read only = false"
            echo "    write only = true"
            echo "    refuse options = delete* remove-source-files"
            echo "    max connections = 4"
            echo "    timeout = 600"
        done < "$RSYNCD_SECRETS"
    } | write_replace "$RSYNCD_CONF" || {
        # Disco cheio: melhor manter a conf anterior (estações continuam enviando) do
        # que deixar um rsyncd.conf vazio, que derrubaria todo o modo usuário+senha.
        disk_hint "$RSYNCD_CONF" >&2
        echo "aviso: rsyncd.conf NÃO foi regenerado — a configuração anterior segue valendo." >&2
        return 0
    }
    chmod 644 "$RSYNCD_CONF"
}

open_firewall_port() {  # tenta liberar a porta do rsyncd no firewall DO HOST
    if command -v ufw >/dev/null 2>&1 && ufw status 2>/dev/null | grep -q "Status: active"; then
        if ufw allow "$RSYNCD_PORT/tcp" >/dev/null 2>&1; then
            echo "ok: porta $RSYNCD_PORT/tcp liberada no firewall do host (ufw)."
        else
            echo "aviso: não consegui liberar a porta $RSYNCD_PORT no ufw — libere manualmente."
        fi
    elif command -v firewall-cmd >/dev/null 2>&1 && firewall-cmd --state >/dev/null 2>&1; then
        if firewall-cmd --permanent --add-port="$RSYNCD_PORT/tcp" >/dev/null 2>&1 \
           && firewall-cmd --reload >/dev/null 2>&1; then
            echo "ok: porta $RSYNCD_PORT/tcp liberada no firewall do host (firewalld)."
        else
            echo "aviso: não consegui liberar a porta $RSYNCD_PORT no firewalld — libere manualmente."
        fi
    else
        echo "(nenhum firewall gerenciável detectado no host — ufw/firewalld inativos ou ausentes.)"
    fi
}

port_listening() {   # $1=porta — alguém escutando? rc 2 = não deu para verificar
    if command -v ss >/dev/null 2>&1; then
        ss -ltn 2>/dev/null | grep -q ":$1 "
    elif command -v netstat >/dev/null 2>&1; then
        netstat -ltn 2>/dev/null | grep -q ":$1 "
    else
        return 2
    fi
}

rsyncd_listening() {  # o daemon está escutando na porta?
    port_listening "$RSYNCD_PORT" || [ $? = 2 ]   # sem como checar: não alarma
}

has_systemd() {  # systemd PRESENTE E RODANDO (PID 1) — só o binário não basta:
                 # num container/chroot o systemctl existe mas 'daemon-reload' falha.
    command -v systemctl >/dev/null 2>&1 && [ -d /run/systemd/system ]
}

ensure_rsyncd() {   # deixa o daemon no ar (config e senhas são relidos a cada conexão)
    rebuild_rsyncd_conf
    if has_systemd; then
        cat > /etc/systemd/system/carbonara-rsyncd.service <<EOF
[Unit]
Description=CARBONARA rsync daemon (estações com usuário+senha)
After=network.target

[Service]
ExecStart=$(command -v rsync) --daemon --no-detach --config=$RSYNCD_CONF
Restart=on-failure

[Install]
WantedBy=multi-user.target
EOF
        systemctl daemon-reload
        systemctl enable --now carbonara-rsyncd >/dev/null 2>&1 || true
        systemctl is-active carbonara-rsyncd >/dev/null 2>&1 || \
            echo "aviso: o serviço carbonara-rsyncd não subiu — veja: systemctl status carbonara-rsyncd"
    else
        # Sem systemd: sobe direto se ainda não estiver rodando (pid file).
        if ! { [ -f "$BASE/rsyncd.pid" ] && kill -0 "$(cat "$BASE/rsyncd.pid" 2>/dev/null)" 2>/dev/null; }; then
            rsync --daemon --config="$RSYNCD_CONF" || echo "aviso: falha ao subir o rsync --daemon"
        fi
    fi
}

write_instructions_pw() {  # $1=id $2=pasta da estação $3=senha
    wp_id="$1"; wp_dir="$2"; wp_pw="$3"; wp_addr="$(host_addr)"
    cat > "$wp_dir/INSTRUCOES.txt" <<EOF
CARBONARA — ativação da estação '$wp_id' (modo USUÁRIO+SENHA)
=============================================================
(gerado por rsync-hub em $(date -u +%FT%TZ))

Servidor (host): $wp_addr · porta: $RSYNCD_PORT (rsync direto, sem SSH)
Credenciais:     usuário: $wp_id   ·   senha: $wp_pw
                 (guarde este arquivo com cuidado — a senha está nele)

1) Copie o cliente para a máquina da estação (pasta collection/station/ do repositório
   carbonara-datahub):
       Linux:    carbonara-station.sh
       Windows:  carbonara-station.ps1 + carbonara-station.cmd

2) Na estação, rode o assistente guiado:
       Linux:    ./carbonara-station.sh setup
       Windows:  .\\carbonara-station.cmd setup
                 (na 1ª vez o assistente instala o rsync (cwRsync) sozinho —
                  abra o PowerShell COMO ADMINISTRADOR só nessa primeira vez)
   Ele pergunta, nesta ordem:
     - id da estação ................ $wp_id
     - IP do host ................... $wp_addr
     - autenticação ................. escolha "usuário e senha"
     - porta ........................ $RSYNCD_PORT (padrão desse modo)
     - senha ........................ a senha acima
     → teste simples de conexão (o host responde? a senha confere?)
     - pasta local a enviar (rsync)
     - tempo de reciclagem (minutos) + ativação do envio automático

3) Pronto. Acompanhe as chegadas no servidor com:  rsync-hub monitor

Observações:
  - Este modo NÃO usa a porta do SSH: a porta $RSYNCD_PORT/tcp precisa estar aberta em
    todo o caminho estação→servidor (firewall do host E firewall/roteador externo).
    Teste rápido, de qualquer máquina:  rsync rsync://$wp_addr:$RSYNCD_PORT/
    (deve responder listando os módulos). Se a porta não puder ser aberta, peça ao
    administrador o modo CHAVE (porta 22).
  - A estação só escreve na própria pasta (incoming/$wp_id), em modo write-only,
    e o servidor recusa --delete: ela não lê, não baixa e não apaga nada.
  - O tráfego NÃO é criptografado (a senha não circula em claro, os dados sim).
    Em redes públicas, prefira o modo chave SSH.
  - Para revogar o acesso:  sudo rsync-hub remove $wp_id
EOF
    # Legível pelos usuários locais do host (política de leitura aberta) — a senha da
    # estação está aqui e o rsyncd.secrets é 644 (strict modes desativado no daemon).
    chmod 644 "$wp_dir/INSTRUCOES.txt"
}

add_station_pw() {   # $1=id $2=senha (vazio = gerar)
    need_root
    id="${1:-}"; pw="${2:-}"
    [ -n "$id" ] || die "uso: rsync-hub add <id> --senha [senha]"
    valid_id "$id"
    [ -d "$BASE" ] || die "host não preparado — rode antes: sudo rsync-hub install"
    command -v rsync >/dev/null 2>&1 || die "'rsync' não encontrado no host"
    [ -n "$pw" ] || pw="$(gen_password)"
    [ -n "$pw" ] || die "falha ao gerar a senha"
    case "$pw" in *:*|*' '*) die "senha não pode conter ':' nem espaço" ;; esac
    install -d -m 755 -o "$HUB_USER" -g "$HUB_USER" "$INCOMING/$id"
    touch "$RSYNCD_SECRETS"; chmod 644 "$RSYNCD_SECRETS"
    if ! { grep -v "^$id:" "$RSYNCD_SECRETS" 2>/dev/null || true
           printf '%s:%s\n' "$id" "$pw"; } | write_replace "$RSYNCD_SECRETS"; then
        disk_hint "$RSYNCD_SECRETS" >&2
        die "estação '$id' NÃO foi autorizada (as senhas existentes foram preservadas)"
    fi
    chmod 644 "$RSYNCD_SECRETS"
    ensure_rsyncd
    open_firewall_port
    keydir="$BASE/stations/$id"
    install -d -m 755 "$keydir"
    write_instructions_pw "$id" "$keydir" "$pw"
    echo "estação '$id' autorizada por USUÁRIO+SENHA (pasta $INCOMING/$id, write-only, sem delete)."
    echo "    usuário: $id"
    echo "    senha:   $pw"
    echo "    porta:   $RSYNCD_PORT"
    echo "    INSTRUCOES.txt (com a senha) em: $keydir/"
    if rsyncd_listening; then
        echo "ok: o daemon está escutando na porta $RSYNCD_PORT deste host."
    else
        echo "AVISO: não vi o daemon escutando na porta $RSYNCD_PORT — confira:"
        echo "       systemctl status carbonara-rsyncd   ·   ss -ltn | grep $RSYNCD_PORT"
    fi
    echo
    echo "IMPORTANTE — este modo NÃO usa a porta do SSH: a porta $RSYNCD_PORT/tcp precisa estar"
    echo "aberta em TODO o caminho até a estação (firewall do host: tentei liberar acima;"
    echo "firewall externo/roteador da instituição: peça a liberação). Teste de qualquer"
    echo "máquina:  rsync rsync://$(host_addr):$RSYNCD_PORT/   (deve listar os módulos)."
    echo "Se a porta $RSYNCD_PORT não puder ser aberta, use o modo CHAVE (porta 22):"
    echo "    sudo rsync-hub add $id"
    echo
    echo "atenção: tráfego SEM criptografia (dados em claro; a senha, não)."
}

add_station() {
    need_root
    id="${1:-}"; pub="${2:-}"
    [ -n "$id" ] || die "uso: rsync-hub add <id> [arquivo_chave_publica]  (sem o arquivo, a chave é gerada aqui)"
    valid_id "$id"
    [ -f "$AUTHKEYS" ] || die "host não preparado — rode antes: sudo rsync-hub install"

    generated=""
    if [ -z "$pub" ]; then
        # Sem chave informada: gera o par AQUI e o guarda na pasta da estação
        # ($BASE/stations/<id> — fora do incoming/, que a estação pode escrever e a
        # ingestão varre), junto com as instruções de ativação. O operador leva a
        # chave privada para a estação.
        keydir="$BASE/stations/$id"
        install -d -m 755 "$keydir"
        key="$keydir/${id}_key"
        if [ ! -f "$key.pub" ]; then
            ssh-keygen -q -t ed25519 -N "" -C "carbonara-$id" -f "$key" || die "falha ao gerar a chave"
        fi
        # Legíveis pelos usuários locais do host (política de leitura aberta: o
        # administrador copia a chave para o operador SEM sudo).
        chmod 644 "$key" "$key.pub"
        pub="$key.pub"; generated=1
    fi
    [ -f "$pub" ] || die "chave pública não encontrada: $pub"
    ssh-keygen -l -f "$pub" >/dev/null 2>&1 || die "não parece uma chave pública SSH: $pub"

    install -d -m 755 -o "$HUB_USER" -g "$HUB_USER" "$INCOMING/$id"
    # O comando forçado do authorized_keys precisa de um caminho que a conta de
    # serviço consiga EXECUTAR para sempre — um script dentro de /home/<admin>/ falha
    # com "Permission denied" (homes são 750). Garante a cópia estável em
    # /usr/local/bin e aponta a chave para ela.
    if [ "$(self_path)" != /usr/local/bin/rsync-hub ]; then
        install -m 755 "$(self_path)" /usr/local/bin/rsync-hub
        SELF=/usr/local/bin/rsync-hub
        echo "script instalado/atualizado em /usr/local/bin/rsync-hub (a chave aponta para lá)."
    fi
    # Remove entrada antiga da mesma estação (se houver) e adiciona a nova — em uma
    # gravação só, que só substitui o arquivo bom se couber inteira (ver write_replace).
    if ! { grep -vF "serve $id\"" "$AUTHKEYS" 2>/dev/null || true
           printf 'command="%s serve %s",restrict %s\n' \
                  "$(self_path)" "$id" "$(cat "$pub")"; } | write_replace "$AUTHKEYS"; then
        disk_hint "$AUTHKEYS" >&2
        die "estação '$id' NÃO foi autorizada (nenhuma chave existente foi perdida)"
    fi
    chown "$HUB_USER:$HUB_USER" "$AUTHKEYS"; chmod 644 "$AUTHKEYS"
    echo "estação '$id' autorizada (pasta $INCOMING/$id)."
    if [ -n "$generated" ]; then
        write_instructions "$id" "$keydir"
        echo "chave da estação gerada e guardada em $keydir/:"
        echo "    ${id}_key        ← COPIE para a máquina da estação (chave privada)"
        echo "    ${id}_key.pub    ← permanece aqui (já autorizada)"
        echo "    INSTRUCOES.txt   ← passo a passo de ativação, para acompanhar a chave"
        echo "(arquivos legíveis pelos usuários locais do host — a cópia dispensa sudo.)"
    else
        echo "no cliente, aponte para: conta $HUB_USER · host $(host_addr) · porta 22 (detalhes: rsync-hub cliente)"
    fi
}

add_station_wizard() {  # versão guiada do add: escolhe o modo de autenticação
    id="$(ask "  id da estação (minúsculas/dígitos/_ , ex.: flona01)" "")"
    [ -n "$id" ] || { echo "  id vazio."; return 1; }
    echo "$id" | grep -Eq '^[a-z0-9][a-z0-9_]{1,30}$' || { echo "  id inválido."; return 1; }
    echo "  como a estação vai se autenticar?"
    echo "    1) chave SSH (recomendado — tráfego criptografado, usa a porta 22 já aberta)"
    echo "    2) usuário e senha (mais simples no cliente — MAS exige a porta $RSYNCD_PORT/tcp"
    echo "       aberta até a estação, além da 22; dados SEM criptografia)"
    modo="$(ask "  modo" "1")"
    if [ "$modo" = 2 ]; then
        pw="$(ask "  senha (ENTER = gerar uma)" "")"
        if ( add_station_pw "$id" "$pw" ); then return 0; else return 1; fi
    fi
    echo "  chave pública da estação: aperte ENTER para GERAR o par aqui no host"
    echo "  (fica em $BASE/stations/$id/ com as instruções de ativação), OU informe o"
    echo "  CAMINHO de um arquivo .pub, OU cole a linha inteira ('ssh-ed25519 …')."
    printf '  chave (ENTER = gerar aqui)> '
    read -r key || return 1
    tmp=""
    case "$key" in
        "")                 pub="" ;;
        ssh-*|ecdsa-*|sk-*) tmp="$(mktemp)"; printf '%s\n' "$key" > "$tmp"; pub="$tmp" ;;
        *)                  pub="$key" ;;
    esac
    # Subshell: um erro no add não derruba o assistente.
    if [ -z "$pub" ]; then
        if ( add_station "$id" ); then rc=0; else rc=1; fi
    else
        if ( add_station "$id" "$pub" ); then rc=0; else rc=1; fi
    fi
    [ -n "$tmp" ] && rm -f "$tmp"
    return "$rc"
}

revoke_access() {  # $1=id — revoga chave E senha; rc 0 = algo foi revogado
    rv_id="$1"; rv_any=1
    if [ -f "$AUTHKEYS" ] && grep -qF "serve $rv_id\"" "$AUTHKEYS"; then
        if grep -vF "serve $rv_id\"" "$AUTHKEYS" | write_replace "$AUTHKEYS"; then
            chown "$HUB_USER:$HUB_USER" "$AUTHKEYS"; chmod 644 "$AUTHKEYS"
            echo "estação '$rv_id': acesso por CHAVE revogado."
            rv_any=0
        else
            disk_hint "$AUTHKEYS" >&2
            die "não consegui reescrever o $AUTHKEYS — NADA foi revogado"
        fi
    fi
    if [ -f "$RSYNCD_SECRETS" ] && grep -q "^$rv_id:" "$RSYNCD_SECRETS"; then
        if grep -v "^$rv_id:" "$RSYNCD_SECRETS" | write_replace "$RSYNCD_SECRETS"; then
            chmod 644 "$RSYNCD_SECRETS"
            rebuild_rsyncd_conf
            echo "estação '$rv_id': acesso por USUÁRIO+SENHA revogado."
            rv_any=0
        else
            disk_hint "$RSYNCD_SECRETS" >&2
            die "não consegui reescrever o $RSYNCD_SECRETS — NADA foi revogado"
        fi
    fi
    return "$rv_any"
}

remove_station() {
    need_root
    id="${1:-}"; [ -n "$id" ] || die "uso: rsync-hub remove <id>"
    valid_id "$id"
    if revoke_access "$id"; then
        echo "dados preservados em $INCOMING/$id."
        [ -d "$BASE/stations/$id" ] && \
            echo "chaves/instruções mantidas em $BASE/stations/$id — apague a pasta se não for reativar."
    else
        echo "estação '$id' não estava autorizada."
    fi
}

station_dirs() {  # $1=id — ecoa (uma por linha) as pastas da estação que EXISTEM.
    # Únicos alvos legítimos de um purge; nunca nada fora destas quatro.
    for sd_d in "$INCOMING/$1" "$BASE/archive/$1" "$BASE/quarantine/$1" "$BASE/stations/$1"; do
        [ -e "$sd_d" ] && printf '%s\n' "$sd_d"
    done
    return 0
}

purge_station() {   # purge <id> [--confirmo] — revoga o acesso E APAGA os dados
    need_root
    id="${1:-}"; ok="${2:-}"
    [ -n "$id" ] || die "uso: rsync-hub purge <id> [--confirmo]"
    valid_id "$id"
    dirs="$(station_dirs "$id")"
    if [ -z "$dirs" ] && ! { [ -f "$AUTHKEYS" ] && grep -qF "serve $id\"" "$AUTHKEYS"; } \
       && ! { [ -f "$RSYNCD_SECRETS" ] && grep -q "^$id:" "$RSYNCD_SECRETS" 2>/dev/null; }; then
        echo "estação '$id': nada a excluir (sem autorização e sem pastas)."
        return 0
    fi
    echo "EXCLUSÃO DEFINITIVA da estação '$id' — revoga o acesso E APAGA do servidor:"
    if [ -n "$dirs" ]; then
        printf '%s\n' "$dirs" | while IFS= read -r d; do
            echo "  $(du -sh "$d" 2>/dev/null | cut -f1)	$d"
        done
    else
        echo "  (nenhuma pasta em disco — só a autorização)"
    fi
    echo "Isto é IRREVERSÍVEL: dados recebidos, arquivados, em quarentena e as"
    echo "chaves/instruções da estação serão apagados. Não há lixeira."
    if [ "$ok" != "--confirmo" ]; then
        is_tty || die "sem terminal: confirme com  rsync-hub purge $id --confirmo"
        printf 'digite o id da estação para confirmar> '
        read -r typed || exit 1
        [ "$typed" = "$id" ] || die "confirmação não confere ('$typed' != '$id') — NADA foi apagado"
    fi
    revoke_access "$id" || true
    # Reconsulta as pastas (uma sessão em andamento pode ter recriado incoming/<id>).
    station_dirs "$id" | while IFS= read -r d; do
        rm -rf "$d" && echo "apagado: $d"
    done
    echo "estação '$id' excluída definitivamente."
}

# Primeira pasta do caminho que a conta de serviço NÃO consegue atravessar (sem o+x).
# Dizer "alguma pasta do caminho" não ajuda ninguém: é preciso apontar QUAL e mostrar
# as permissões dela — o caso clássico é /media/<usuario>, que o udisks cria 700.
path_blocker() {   # $1=caminho absoluto → ecoa a pasta bloqueadora (rc 0) ou nada (rc 1)
    pb_target="$1"; pb_cur=""
    set -f; oldifs="$IFS"; IFS='/'
    # shellcheck disable=SC2086 — a divisão em componentes é intencional
    set -- $pb_target
    IFS="$oldifs"; set +f
    for pb_c in "$@"; do
        [ -n "$pb_c" ] || continue
        pb_cur="$pb_cur/$pb_c"
        [ -d "$pb_cur" ] || continue
        su -s /bin/sh -c "test -x '$pb_cur'" "$HUB_USER" 2>/dev/null || {
            printf '%s\n' "$pb_cur"; return 0; }
    done
    return 1
}

MIGR_MARK=".rsync-hub-migracao"   # marca uma migração em andamento no DESTINO

# Processos rodando como a conta de serviço — é exatamente o que faz o `usermod -d`
# recusar ("user is currently used by process N"). Checar ANTES evita descobrir isso
# depois de copiar gigabytes.
hub_user_procs() {
    ps -u "$HUB_USER" -o pid=,etime=,args= 2>/dev/null | sed 's/^[[:space:]]*//' | grep . || true
}

# Explica QUEM está segurando a conta e como sair de cada caso — a distinção é o que
# destrava o administrador. São duas naturezas bem diferentes:
#   - sessão de ESTAÇÃO (sshd + serve + rrsync + rsync): termina sozinha; a pausa já
#     impede que outra comece, então é só esperar (ou encerrar — o cliente reenvia);
#   - restos do GERENCIADOR DE SESSÃO do systemd (systemd --user, sd-pam, pipewire,
#     dbus-daemon, xdg-*): o pam_systemd os cria a cada login SSH da conta e eles
#     sobrevivem à sessão. Esperar não resolve — só 'loginctl terminate-user'.
explica_conta_ocupada() {   # $1 = saída de hub_user_procs
    eco_p="$1"
    eco_est="$(printf '%s\n' "$eco_p" | grep -E 'rsync-hub serve|rrsync|rsync --server|sshd:' || true)"
    eco_ses="$(printf '%s\n' "$eco_p" | grep -E 'systemd --user|\(sd-pam\)|pipewire|dbus-daemon|xdg-' || true)"
    eco_out="$(printf '%s\n' "$eco_p" | grep -vE 'rsync-hub serve|rrsync|rsync --server|sshd:|systemd --user|\(sd-pam\)|pipewire|dbus-daemon|xdg-' || true)"
    if [ -n "$eco_est" ]; then
        echo "      • ESTAÇÃO enviando agora — espere terminar (a pausa já impede novas):" >&2
        printf '%s\n' "$eco_est" | sed 's/^/          /' >&2
        echo "        acompanhe com:  ps -u $HUB_USER -o pid,etime,args" >&2
        echo "        para encerrar já (seguro: o cliente reenvia no próximo ciclo):" >&2
        echo "            sudo pkill -u $HUB_USER -f 'rsync-hub serve'" >&2
    fi
    if [ -n "$eco_ses" ]; then
        echo "      • restos do GERENCIADOR DE SESSÃO do systemd — NÃO são estações; o" >&2
        echo "        pam_systemd os cria a cada login SSH da conta e eles seguram o usermod:" >&2
        printf '%s\n' "$eco_ses" | sed 's/^/          /' >&2
        echo "        encerre com:    sudo loginctl terminate-user $HUB_USER" >&2
        echo "        e, para não voltarem sozinhos:  sudo loginctl disable-linger $HUB_USER" >&2
    fi
    if [ -n "$eco_out" ]; then
        echo "      • outros processos da conta:" >&2
        printf '%s\n' "$eco_out" | sed 's/^/          /' >&2
    fi
}

# O ponto de montagem que contém o caminho está declarado no /etc/fstab? Um disco em
# /media montado pelo FSTAB é uma coisa (sobe no boot, permissões estáveis); montado
# pelo udisks é outra (some ao desplugar, pasta recriada 700). Sem essa distinção o
# aviso dispara em cima de uma configuração correta — e aviso que grita à toa deixa de
# ser lido.
in_fstab() {   # $1=caminho → rc 0 se o ponto de montagem que o contém está no fstab
    command -v findmnt >/dev/null 2>&1 || return 1
    if_mp="$(findmnt -n -o TARGET --target "$1" 2>/dev/null | tail -1)"
    [ -n "$if_mp" ] || return 1
    findmnt --fstab -n -o TARGET "$if_mp" >/dev/null 2>&1
}

# Sistema de arquivos do caminho (usa o ancestral existente mais profundo).
fs_type_of() {   # $1=caminho → ecoa o tipo (ext4, exfat, fuseblk…) ou vazio
    ft_p="$1"
    while [ ! -d "$ft_p" ] && [ "$ft_p" != "/" ]; do ft_p="$(dirname "$ft_p")"; done
    # O rc do pipe é o do awk (sempre 0), então a detecção é pela SAÍDA, não pelo rc —
    # senão o fallback nunca rodaria onde o 'df -T' não existe. Vazio = não sei: neste
    # caso o move-root segue (não inventamos motivo para recusar).
    ft_t="$(df -PT "$ft_p" 2>/dev/null | awk 'NR==2{print $2}')"
    [ -n "$ft_t" ] || ft_t="$(stat -f -c %T "$ft_p" 2>/dev/null || true)"
    # O 'stat -f -c' é GNU; em outros stat o '-c' volta ecoado. Descarta lixo: um tipo
    # de sistema de arquivos nunca começa com '-' nem tem espaço.
    case "$ft_t" in -*|*\ *) ft_t="" ;; esac
    printf '%s\n' "$ft_t"
}

move_root() {   # move-root <novo> [--confirmo] — migra a RAIZ INTEIRA do hub
    # Por que a raiz inteira (e nunca só incoming/): o hub deriva TUDO da BASE —
    # INCOMING=$BASE/incoming, o home da conta de serviço É a BASE (o sshd acha o
    # authorized_keys por ele), e o rsyncd.conf/unit systemd embutem caminhos
    # absolutos. Mover um pedaço quebraria esses invariantes; mover a BASE mantém
    # o modelo com uma variável só. A raiz antiga NUNCA é apagada por este comando.
    need_root
    new=""; ok=""; ignora_busy=""; retomando=""
    for mr_a in "$@"; do
        case "$mr_a" in
            --confirmo)        ok="--confirmo" ;;
            --ignorar-ocupado) ignora_busy=1 ;;
            -*) die "opção desconhecida: $mr_a (use --confirmo / --ignorar-ocupado)" ;;
            *)  if [ -z "$new" ]; then new="$mr_a"; else die "argumento extra: $mr_a"; fi ;;
        esac
    done
    [ -n "$new" ] || die "uso: rsync-hub move-root <novo_caminho_absoluto> [--confirmo]"
    case "$new" in /*) : ;; *) die "use um caminho ABSOLUTO (começando com /)" ;; esac
    new="$(printf '%s' "$new" | sed 's:/*$::')"
    [ -n "$new" ] || die "não dá para usar '/' como raiz"
    # Sem espaços/aspas/':'/'\' no caminho: eles quebrariam o rsyncd.conf gerado
    # (path= não tem escape), o INSTRUCOES e invocações citadas — mesma restrição
    # prática do install.
    case "$new" in
        *[\ \	]*|*\'*|*\"*|*:*|*\\*) die "o novo caminho não pode conter espaços, aspas, ':' ou '\\'" ;;
    esac
    old="$BASE"
    [ "$new" != "$old" ] || die "o novo caminho é igual à raiz atual ($old)"
    case "$new/" in "$old"/*) die "o novo caminho fica DENTRO da raiz atual ($old)" ;; esac
    case "$old/" in "$new"/*) die "a raiz atual ($old) fica dentro do novo caminho" ;; esac
    [ -d "$old" ] || die "raiz atual não existe: $old (confira $CONF_FILE)"
    command -v rsync >/dev/null 2>&1 || die "'rsync' é necessário para copiar os dados"
    id "$HUB_USER" >/dev/null 2>&1 || die "conta '$HUB_USER' não existe — rode: sudo rsync-hub install"
    if [ -e "$new" ]; then
        [ -d "$new" ] || die "o destino existe e não é uma pasta: $new"
        if [ -n "$(ls -A "$new" 2>/dev/null)" ]; then
            # Migração interrompida DESTE MESMO hub: retomar é o certo — o rsync
            # completa só o que falta. Sem isso, uma falha no passo 2 (usermod) deixava
            # o administrador preso: a retentativa batia em "destino não está vazio" e a
            # única saída seria apagar à mão o que acabou de ser copiado.
            if [ -f "$new/$MIGR_MARK" ] && grep -Fqx "origem=$old" "$new/$MIGR_MARK" 2>/dev/null; then
                retomando=1
                echo "nota: há uma migração interrompida deste hub em $new — vou RETOMAR"
                echo "      (o rsync copia só o que falta; nada é recopiado à toa)."
            else
                # Um disco novo montado direto no destino traz 'lost+found' (ext4) — o
                # caminho certo é migrar para uma SUBPASTA do ponto de montagem, não
                # para o ponto em si; dizer isso evita um segundo erro confuso.
                if [ "$(ls -A "$new" 2>/dev/null)" = "lost+found" ]; then
                    echo "aviso: $new é um ponto de montagem recém-formatado (só tem lost+found)." >&2
                    echo "       Migre para uma SUBPASTA dele, ex.: $new/carbonara" >&2
                fi
                die "o destino existe e NÃO está vazio: $new"
            fi
        fi
    fi

    # O modelo do hub REPOUSA em dono/permissão POSIX: o sshd (StrictModes) recusa um
    # authorized_keys gravável por grupo/outros, o rrsync confia no dono, e a política
    # de leitura usa 644/755. Um sistema de arquivos que não guarda isso (pendrive/HD
    # externo formatado em exFAT/NTFS/FAT monta tudo 777 de um dono fixo) derruba a
    # autenticação de TODAS as estações assim que a raiz for para lá.
    fstype="$(fs_type_of "$new")"
    case "$fstype" in
        vfat|msdos|exfat|ntfs|ntfs3|fuseblk|iso9660|hfs|hfsplus)
            echo "erro: o destino está em um sistema de arquivos '$fstype', que NÃO guarda" >&2
            echo "      dono e permissões do Linux. A raiz do hub PRECISA deles:" >&2
            echo "      o sshd recusa o authorized_keys se ele ficar gravável por outros" >&2
            echo "      — as estações passariam a receber 'Permission denied (publickey)'." >&2
            echo "      Formate o disco em ext4 (ou use uma pasta do disco do sistema)." >&2
            die "migração recusada (nada foi migrado)" ;;
        nfs|nfs4|cifs|smb3|smbfs)
            echo "AVISO: destino em rede ('$fstype') — dono/permissões dependem do mapeamento" >&2
            echo "       do servidor, e uma queda da rede derruba a coleta inteira." >&2 ;;
    esac

    # Ponto de montagem removível: a raiz É o home da conta de serviço. Se o disco não
    # estiver montado no boot, o sshd não acha o authorized_keys (estações fora) e o hub
    # volta a escrever no ponto de montagem VAZIO do disco interno.
    case "$new/" in
        /media/*|/run/media/*|/mnt/*)
            if in_fstab "$new"; then
                echo "nota: o disco de destino está no /etc/fstab (monta no boot) — ok."
                echo "      Dois pontos de atenção que sobram nesse caminho:"
                echo "      1) /media/<usuario> é território do udisks: se ele recriar essa pasta"
                echo "         (ao montar qualquer outro dispositivo para esse usuário), ela volta a"
                echo "         700 e a conta '$HUB_USER' perde o acesso — estações fora do ar."
                echo "         Mais seguro é mover o PONTO DE MONTAGEM para fora de /media,"
                echo "         trocando só a linha do fstab (ex.: /srv/carbonara-dados)."
                echo "      2) com 'nofail', um boot sem o disco deixa a raiz VAZIA e as estações"
                echo "         sem autenticação — 'rsync-hub diagnostico' detecta e avisa."
            else
                echo "AVISO: $new parece um disco removível montado pelo usuário (não está no" >&2
                echo "       /etc/fstab). A raiz do hub é o home da conta '$HUB_USER': se o disco" >&2
                echo "       não estiver montado, o sshd não acha as chaves e as estações caem." >&2
                echo "       Declare o disco no /etc/fstab, num caminho fixo (ex.: /srv/carbonara-dados)." >&2
            fi ;;
    esac

    # A troca do home (usermod) é recusada enquanto existir processo da conta de
    # serviço — tipicamente uma estação enviando agora. Barra AQUI, antes da cópia.
    mr_procs="$(hub_user_procs)"
    if [ -n "$mr_procs" ] && [ -z "$ignora_busy" ]; then
        echo "erro: há processo(s) rodando como a conta '$HUB_USER' — a troca do home" >&2
        echo "      (passo 2) seria recusada e a cópia teria sido feita à toa." >&2
        explica_conta_ocupada "$mr_procs"
        echo "      Com a conta livre (ps sem saída), repita:" >&2
        echo "          sudo rsync-hub move-root $new" >&2
        echo "      A recepção pausada impede novas conexões durante a migração:" >&2
        echo "          sudo rsync-hub pause --todas \"migração da raiz de dados\"" >&2
        echo "          …migração…" >&2
        echo "          sudo rsync-hub resume --todas" >&2
        echo "      Se nada acima puder ser encerrado, repita com --ignorar-ocupado (o" >&2
        echo "      usermod pode falhar mesmo assim — a cópia então fica retomável)." >&2
        die "migração não iniciada (nada foi copiado)"
    fi

    echo "Mover a raiz do hub:  $old  →  $new"
    echo "  - copia TUDO (incoming/, archive/, stations/, .ssh/, log/…) preservando dono/permissões;"
    echo "  - muda o home da conta '$HUB_USER' (o sshd lê o authorized_keys por ele);"
    echo "  - regrava $CONF_FILE e regenera/reinicia o rsyncd (se o modo senha estiver em uso);"
    echo "  - a raiz antiga é PRESERVADA como cópia de segurança (remoção só manual)."
    if [ "$ok" != "--confirmo" ]; then
        is_tty || die "sem terminal: confirme com  rsync-hub move-root $new --confirmo"
        ask_yn "Confirmar a migração agora?" n || { echo "cancelado — nada foi alterado."; exit 1; }
    fi

    # Destino com o mesmo dono/modo da raiz atual; e a conta de serviço PRECISA
    # alcançá-lo (pais com o+x) — mesmo requisito de sempre do sshd/rrsync.
    install -d "$new"
    chown --reference="$old" "$new" 2>/dev/null || chown "$HUB_USER:$HUB_USER" "$new"
    chmod --reference="$old" "$new" 2>/dev/null || chmod 755 "$new"
    if ! su -s /bin/sh -c "test -r '$new' && test -x '$new'" "$HUB_USER" 2>/dev/null; then
        blocker="$(path_blocker "$new" || true)"
        echo "erro: a conta de serviço '$HUB_USER' não consegue chegar até $new." >&2
        if [ -n "$blocker" ]; then
            echo "      A pasta que bloqueia é:  $blocker" >&2
            ls -ld "$blocker" 2>/dev/null | sed 's/^/        /' >&2
            echo "      Ela precisa de 'o+x' (atravessar) para a conta do hub:" >&2
            echo "          sudo chmod o+x $blocker" >&2
            case "$blocker" in
                /media/*|/run/media/*)
                    echo "      OBS.: pastas em /media/<usuario> são criadas 700 pelo sistema a cada" >&2
                    echo "            montagem — o chmod não sobrevive a desmontar/montar. Para uma raiz" >&2
                    echo "            de hub, monte o disco por /etc/fstab em um caminho fixo." >&2 ;;
            esac
        else
            echo "      Verifique as permissões de leitura/execução do caminho inteiro." >&2
        fi
        die "migração recusada (nada foi migrado)"
    fi

    # Marca a migração em andamento: é o que permite RETOMAR se algo falhar no meio.
    { echo "origem=$old"; echo "inicio=$(date -u +%FT%TZ)"; } > "$new/$MIGR_MARK" 2>/dev/null || true

    if [ -n "$retomando" ]; then
        echo "[1/4] completando a cópia interrompida…"
    else
        echo "[1/4] copiando os dados (primeira passada — pode demorar)…"
    fi
    rsync -aH "$old"/ "$new"/ || die "cópia falhou — NADA foi alterado; a raiz continua $old"

    echo "[2/4] trocando a configuração para a nova raiz…"
    # Ordem deliberada: home primeiro (se falhar — ex.: estação conectada agora —
    # nada mudou e dá para tentar de novo); depois o conf, que redireciona o serve.
    if ! mr_err="$(usermod -d "$new" "$HUB_USER" 2>&1)"; then
        [ -n "$mr_err" ] && printf '%s\n' "$mr_err" | sed 's/^/      /' >&2
        mr_procs="$(hub_user_procs)"
        if [ -n "$mr_procs" ]; then
            echo "      quem está segurando a conta '$HUB_USER' agora:" >&2
            explica_conta_ocupada "$mr_procs"
        fi
        echo "      A CÓPIA JÁ ESTÁ EM $new e fica preservada: repita o mesmo comando com a" >&2
        echo "      recepção pausada e ele RETOMA daqui (não recopia tudo):" >&2
        echo "          sudo rsync-hub pause --todas \"migração da raiz de dados\"" >&2
        echo "          sudo rsync-hub move-root $new" >&2
        echo "          sudo rsync-hub resume --todas" >&2
        die "home de '$HUB_USER' não foi alterado — a raiz continua $old"
    fi
    BASE="$new"; derive_paths; save_conf
    grep -q "BASE=$new" "$CONF_FILE" 2>/dev/null || \
        echo "AVISO: confira $CONF_FILE — deveria conter BASE=$new"

    echo "[3/4] sincronização final (pega o que chegou durante a cópia)…"
    rsync -aH "$old"/ "$new"/ || echo "AVISO: a passada final falhou — compare $old e $new manualmente"

    echo "[4/4] serviços…"
    rm -f "$new/rsyncd.pid" "$new/rsyncd.lock"   # cópias do daemon antigo (stale)
    if [ -s "$RSYNCD_SECRETS" ]; then
        if has_systemd; then
            ensure_rsyncd
            systemctl restart carbonara-rsyncd 2>/dev/null || true
        else
            # Sem systemd: derruba o daemon antigo e ESPERA ele soltar a porta —
            # o kill é assíncrono e o daemon novo morreria com "address in use".
            mr_pid="$(cat "$old/rsyncd.pid" 2>/dev/null || true)"
            if [ -n "$mr_pid" ]; then
                kill "$mr_pid" 2>/dev/null || true
                for _ in 1 2 3 4 5; do
                    kill -0 "$mr_pid" 2>/dev/null || break
                    sleep 1
                done
            fi
            ensure_rsyncd
        fi
        echo "  rsyncd (modo senha) regenerado para a nova raiz e reiniciado."
    else
        echo "  (modo senha não está em uso — nada a fazer no rsyncd.)"
    fi

    rm -f "$new/$MIGR_MARK"    # migração concluída: o destino deixa de ser "em andamento"

    cat > "$old/RAIZ-MIGRADA.txt" <<EOF
Esta raiz foi MIGRADA para: $new
em $(date -u +%FT%TZ), por 'rsync-hub move-root' (v$RSYNC_HUB_VERSION).

Os envios novos já chegam na nova raiz. Esta pasta ficou como cópia de segurança:
depois de conferir que está tudo certo (recepção E ingestão na nova raiz),
ela pode ser removida manualmente.
EOF

    echo
    echo "===== Migração concluída: $old → $new ====="
    echo
    echo "As ESTAÇÕES não precisam de NENHUMA mudança: o destino delas é decidido pelo"
    echo "servidor a cada conexão (o serve lê $CONF_FILE), então os próximos envios já"
    echo "caem na nova raiz automaticamente — chave e senha."
    echo
    echo "Pendências (manuais) só nos CONSUMIDORES da raiz, se você os usa:"
    echo "  1. SE este servidor roda a pilha Docker do projeto (banco/ingestão/FTP —"
    echo "     confira com 'docker compose ps' na pasta do repositório): ajuste"
    echo "     CARBONARA_ROOT=$new no arquivo .env e rode 'docker compose up -d';"
    echo "     containers congelam o caminho montado quando sobem. Não usa Docker"
    echo "     aqui? Ignore este item."
    echo "  2. dashboard: ajuste a raiz em Configurações para $new"
    echo "     (se a migração foi disparada pela dashboard, isso já foi feito)."
    echo "  3. confira uma recepção na nova raiz; só então remova a raiz antiga"
    echo "     (ficou intacta, com um RAIZ-MIGRADA.txt de aviso)."
}

# --- Pausa da recepção -------------------------------------------------------------
# PAUSAR é suspender a CHEGADA de dados sem revogar nada e sem apagar nada — o cenário
# típico é manutenção do servidor (disco, migração, banco parado). Como funciona:
#   - modo CHAVE SSH: o `serve` recusa a sessão (registra PAUSED no log e devolve a
#     mensagem à estação);
#   - modo USUÁRIO+SENHA: o módulo da estação some do rsyncd.conf, regenerado aqui — o
#     daemon relê a config a cada conexão, então vale na hora.
# Em ambos os casos o cliente vê uma falha, NÃO avança o estado local e reenvia tudo no
# ciclo seguinte: pausa adia a coleta, não perde dado. Enquanto pausada, a estação
# também não consegue mandar o sinal de vida — por isso o status vira "Pausada" (e não
# "Offline") no monitor e na dashboard.
#
# Marcadores: $PAUSE_DIR/_todas (global) e $PAUSE_DIR/<id> (por estação), em 644 dentro
# de uma pasta 755 — a dashboard LÊ o estado sem sudo (mesma política de leitura aberta
# do resto do hub) e só a ESCRITA (pause/resume) passa por root.

resolve_pause_target() {  # $1=<id>|--todas → define PT_FILE, PT_LABEL e PT_ID
    case "${1:-}" in
        --todas|--all|all|todas)
            PT_FILE="$PAUSE_ALL"; PT_LABEL="TODAS as estações"; PT_ID="" ;;
        "")  die "informe a estação (id) ou --todas para a recepção inteira" ;;
        -*)  die "opção desconhecida: '$1' (use <id> ou --todas)" ;;
        *)   valid_id "$1"; PT_FILE="$PAUSE_DIR/$1"; PT_LABEL="a estação '$1'"; PT_ID="$1" ;;
    esac
}

is_paused() {   # $1=id — rc 0 se a recepção está pausada (global OU só dessa estação)
    [ -f "$PAUSE_ALL" ] && return 0
    [ -n "${1:-}" ] && [ -f "$PAUSE_DIR/$1" ]
}

pause_field() {  # $1=arquivo $2=campo → ecoa o valor (vazio se não existir)
    [ -f "$1" ] || return 0
    sed -n "s/^$2=//p" "$1" 2>/dev/null | tr -d '\r' | head -1
}

pause_note() {   # $1=arquivo → "desde X · motivo: Y" (para exibir ao admin/estação)
    pn_since="$(pause_field "$1" desde)"; pn_why="$(pause_field "$1" motivo)"
    pn_out=""
    [ -n "$pn_since" ] && pn_out="desde $pn_since"
    [ -n "$pn_why" ] && pn_out="${pn_out:+$pn_out · }motivo: $pn_why"
    [ -n "$pn_out" ] || pn_out="sem detalhes"
    echo "$pn_out"
}

pause_list() {   # ecoa uma linha por pausa ativa (vazio = nada pausado)
    [ -d "$PAUSE_DIR" ] || return 0
    [ -f "$PAUSE_ALL" ] && echo "  - TODAS as estações ($(pause_note "$PAUSE_ALL"))"
    for pf in "$PAUSE_DIR"/*; do
        [ -f "$pf" ] || continue
        pb="$(basename "$pf")"
        [ "$pb" = "_todas" ] && continue
        echo "  - $pb ($(pause_note "$pf"))"
    done
    return 0
}

pause_reception() {   # pause <id|--todas> [motivo...]
    need_root
    resolve_pause_target "${1:-}"
    [ $# -gt 0 ] && shift
    motivo="$*"
    install -d -m 755 "$PAUSE_DIR"
    if ! { echo "# marcador de PAUSA da recepção — criado por rsync-hub"
           echo "desde=$(date -u +%FT%TZ)"
           echo "por=${SUDO_USER:-$(id -un)}"
           echo "motivo=$motivo"; } | write_replace "$PT_FILE"; then
        disk_hint "$PT_FILE" >&2
        die "não consegui gravar o marcador de pausa"
    fi
    chmod 644 "$PT_FILE"
    [ -f "$RSYNCD_SECRETS" ] && rebuild_rsyncd_conf
    echo "recepção PAUSADA para $PT_LABEL."
    [ -n "$motivo" ] && echo "motivo: $motivo"
    echo "as estações continuam autorizadas e nada foi apagado — elas tentam, recebem"
    echo "uma recusa e reenviam quando a recepção voltar."
    if [ -n "$PT_ID" ]; then
        echo "retomar: sudo rsync-hub resume $PT_ID"
    else
        echo "retomar: sudo rsync-hub resume --todas"
    fi
    return 0
}

resume_reception() {  # resume <id|--todas>
    need_root
    resolve_pause_target "${1:-}"
    if [ -f "$PT_FILE" ]; then
        rm -f "$PT_FILE"
        [ -f "$RSYNCD_SECRETS" ] && rebuild_rsyncd_conf
        echo "recepção RETOMADA para $PT_LABEL."
    else
        echo "$PT_LABEL: a recepção não estava pausada — nada a fazer."
    fi
    # Pausa global e pausa por estação são independentes: retomar uma não apaga a
    # outra. Avisa o que continua valendo para não parecer que "não funcionou".
    if [ -n "$PT_ID" ] && [ -f "$PAUSE_ALL" ]; then
        echo "atenção: a pausa GLOBAL continua ativa — '$PT_ID' só volta a receber com:"
        echo "         sudo rsync-hub resume --todas"
    fi
    if [ -z "$PT_ID" ]; then
        rest="$(pause_list)"
        if [ -n "$rest" ]; then
            echo "ainda pausadas individualmente:"
            echo "$rest"
        fi
    fi
    return 0
}

menu_pause() {   # opção do menu interativo
    echo "Pausar a recepção: ENTER = TODAS as estações, ou digite o id de UMA."
    mp_id="$(ask "estação (vazio = todas)" "")"
    mp_why="$(ask "motivo (opcional — aparece no monitor e na dashboard)" "")"
    ( pause_reception "${mp_id:---todas}" "$mp_why" ) || true
}

menu_resume() {  # opção do menu interativo
    echo "Retomar a recepção: ENTER = TODAS as estações, ou digite o id de UMA."
    mr_id="$(ask "estação (vazio = todas)" "")"
    ( resume_reception "${mr_id:---todas}" ) || true
}

# --- Diagnóstico e reparo do acesso -------------------------------------------------
# Para responder à pergunta mais comum do servidor: "as estações pararam de enviar, por
# quê?". Concentra num lugar só as causas que já apareceram na prática — disco cheio,
# authorized_keys perdido, home da conta de serviço fora da BASE (move-root pela metade),
# script do comando forçado ausente, recepção pausada. É só LEITURA; com --reparar,
# reautoriza as estações cujo .pub está guardado em stations/<id>/.
diagnose() {
    dg_fix=""
    case "${1:-}" in
        --reparar|--repair|--fix) dg_fix=1 ;;
        "") : ;;
        *) die "uso: rsync-hub diagnostico [--reparar]" ;;
    esac
    [ -z "$dg_fix" ] || need_root
    echo "===== rsync-hub v$RSYNC_HUB_VERSION — diagnóstico do servidor ====="
    echo "raiz (BASE): $BASE   ·   conta de serviço: $HUB_USER"
    dg_prob=0

    echo
    echo "-- 1. espaço em disco --"
    df -h "$BASE" 2>/dev/null | sed 's/^/  /' || echo "  (não consegui ler o df de $BASE)"
    dg_use="$(df -P "$BASE" 2>/dev/null | awk 'NR==2{gsub("%","",$5); print $5}')"
    if [ -n "$dg_use" ] && [ "$dg_use" -ge 95 ] 2>/dev/null; then
        echo "  PROBLEMA: partição em ${dg_use}% — libere espaço ANTES de qualquer outra coisa."
        echo "            (com o disco cheio, gravações de controle falham e nada mais se sustenta)"
        dg_prob=$((dg_prob + 1))
    fi

    echo
    echo "-- 1b. a raiz está montada? --"
    if command -v findmnt >/dev/null 2>&1; then
        findmnt -n -o TARGET,SOURCE,FSTYPE,OPTIONS --target "$BASE" 2>/dev/null | sed 's/^/  /' || true
    else
        df -PT "$BASE" 2>/dev/null | sed 's/^/  /' || true
    fi
    # Raiz em disco separado + boot sem o disco = ponto de montagem VAZIO no disco
    # interno: o sshd não acha o authorized_keys e TODAS as estações caem. O sintoma
    # (raiz existe, mas sem incoming/) é indistinguível de "instalação nova" — por
    # isso o diagnóstico precisa dizer com todas as letras o que provavelmente é.
    if [ -d "$BASE" ] && [ ! -d "$INCOMING" ]; then
        echo "  PROBLEMA: $BASE existe mas NÃO contém incoming/."
        echo "            Se a raiz mora num disco separado, ele provavelmente NÃO está"
        echo "            montado agora — o sistema subiu com o ponto de montagem vazio."
        echo "            Monte e confira:   sudo mount -a && ls -la $BASE"
        echo "            (as estações ficam sem autenticação enquanto isso)"
        dg_prob=$((dg_prob + 1))
    fi

    echo
    echo "-- 2. conta de serviço e home (é por ele que o sshd acha o authorized_keys) --"
    dg_home="$(getent passwd "$HUB_USER" 2>/dev/null | cut -d: -f6)"
    if [ -z "$dg_home" ]; then
        echo "  PROBLEMA: o usuário '$HUB_USER' não existe — rode: sudo rsync-hub install"
        dg_prob=$((dg_prob + 1))
    else
        echo "  home de $HUB_USER: $dg_home"
        if [ "$dg_home" != "$BASE" ]; then
            echo "  PROBLEMA: o home NÃO é a BASE ($BASE). O sshd procura o authorized_keys"
            echo "            no HOME — é assim que fica um 'move-root' interrompido."
            echo "            corrija com: sudo usermod -d $BASE $HUB_USER"
            dg_prob=$((dg_prob + 1))
        fi
    fi

    echo
    echo "-- 3. chaves autorizadas ($AUTHKEYS) --"
    dg_keys=0
    if [ ! -f "$AUTHKEYS" ]; then
        echo "  PROBLEMA: o arquivo não existe."
        dg_prob=$((dg_prob + 1))
    else
        dg_keys="$(grep -c 'serve ' "$AUTHKEYS" 2>/dev/null || true)"
        [ -n "$dg_keys" ] || dg_keys=0
        echo "  estações com chave: $dg_keys   ·   $(ls -ld "$AUTHKEYS" | awk '{print $1" "$3":"$4" "$5" bytes"}')"
        if [ "$dg_keys" = 0 ]; then
            echo "  PROBLEMA: NENHUMA chave autorizada — é exatamente isto que faz TODAS as"
            echo "            estações receberem 'Permission denied (publickey,password)'."
            dg_prob=$((dg_prob + 1))
        fi
        # StrictModes do sshd: o que ele recusa é escrita de grupo/outros (leitura é ok).
        case "$(ls -ld "$BASE/.ssh" 2>/dev/null | cut -c1-10)" in
            *w*w*|?????w*|????????w?) echo "  ATENÇÃO: $BASE/.ssh gravável por grupo/outros — o sshd recusa (StrictModes)." ;;
        esac
    fi

    echo
    echo "-- 4. script do comando forçado --"
    if [ -x /usr/local/bin/rsync-hub ]; then
        echo "  ok: /usr/local/bin/rsync-hub presente e executável."
        if ! cmp -s "$(self_path)" /usr/local/bin/rsync-hub 2>/dev/null; then
            echo "  ATENÇÃO: a cópia instalada difere desta — atualize:"
            echo "           sudo install -m 755 $(self_path) /usr/local/bin/rsync-hub"
        fi
    else
        echo "  PROBLEMA: /usr/local/bin/rsync-hub não existe/não é executável — as chaves"
        echo "            apontam para ele; sem ele a estação conecta e cai na hora."
        echo "            corrija com: sudo install -m 755 $(self_path) /usr/local/bin/rsync-hub"
        dg_prob=$((dg_prob + 1))
    fi

    echo
    echo "-- 5. recepção pausada? --"
    dg_p="$(pause_list)"
    if [ -n "$dg_p" ]; then
        echo "$dg_p"
        echo "  (pausa é intencional: a estação recebe 'recepção PAUSADA', não 'Permission denied')"
    else
        echo "  nenhuma pausa ativa."
    fi

    echo
    echo "-- 6. estações conhecidas × chave autorizada --"
    dg_falta=""
    if [ -d "$BASE/stations" ]; then
        for dg_d in "$BASE/stations"/*/; do
            [ -d "$dg_d" ] || continue
            dg_id="$(basename "$dg_d")"
            dg_pub="$(ls "$dg_d"*.pub 2>/dev/null | head -1 || true)"
            if [ -f "$AUTHKEYS" ] && grep -qF "serve $dg_id\"" "$AUTHKEYS" 2>/dev/null; then
                echo "  ok       $dg_id — chave autorizada"
            elif grep -q "^$dg_id:" "$RSYNCD_SECRETS" 2>/dev/null; then
                echo "  ok       $dg_id — modo usuário+senha (porta $RSYNCD_PORT)"
            elif [ -n "$dg_pub" ]; then
                echo "  RECUPERÁVEL  $dg_id — sem chave no authorized_keys, mas o .pub está guardado"
                dg_falta="$dg_falta $dg_id"
            else
                echo "  SEM CHAVE    $dg_id — nada autorizado e nenhum .pub guardado aqui"
            fi
        done
    fi
    [ -d "$BASE/stations" ] || echo "  (sem pasta $BASE/stations)"

    if [ -n "$dg_falta" ]; then
        dg_prob=$((dg_prob + 1))
        echo
        if [ -n "$dg_fix" ]; then
            echo "-- reparando (reautorizando com o .pub guardado no hub) --"
            for dg_id in $dg_falta; do
                dg_pub="$(ls "$BASE/stations/$dg_id"/*.pub 2>/dev/null | head -1 || true)"
                [ -n "$dg_pub" ] || continue
                ( add_station "$dg_id" "$dg_pub" ) || echo "  falhou: $dg_id"
            done
            echo "reparo concluído — peça a uma estação para tentar de novo."
        else
            echo "REPARO DISPONÍVEL: as estações acima podem ser reautorizadas com as chaves"
            echo "públicas que o hub já guarda (a estação NÃO precisa de chave nova):"
            echo "    sudo rsync-hub diagnostico --reparar"
        fi
    fi

    echo
    echo "-- 7. últimas conexões --"
    if [ -s "$LOG" ]; then tail -n 8 "$LOG" | fmt_log_local; else echo "  (sem registros em $LOG)"; fi

    echo
    if [ "$dg_prob" = 0 ]; then
        echo "nenhum problema encontrado no lado do servidor."
        echo "se a estação ainda falha, veja no host: sudo journalctl -u ssh -n 50   (ou /var/log/auth.log)"
    else
        echo "$dg_prob ponto(s) de atenção acima."
    fi
    return 0
}

list_stations() {
    any=0
    if [ -f "$AUTHKEYS" ] && grep -q 'serve ' "$AUTHKEYS"; then
        echo "estações por CHAVE SSH:"
        sed -n 's/.*serve \([^"]*\)".*/  - \1/p' "$AUTHKEYS" | sort
        any=1
    fi
    if [ -r "$RSYNCD_SECRETS" ] && grep -q ':' "$RSYNCD_SECRETS" 2>/dev/null; then
        echo "estações por USUÁRIO+SENHA (rsync daemon, porta $RSYNCD_PORT):"
        cut -d: -f1 "$RSYNCD_SECRETS" | sort | sed 's/^/  - /'
        any=1
    fi
    [ "$any" = 1 ] || echo "(nenhuma estação autorizada — use 'rsync-hub add')"
    paused="$(pause_list)"
    if [ -n "$paused" ]; then
        echo "recepção PAUSADA (autorizadas, mas nenhum dado é aceito agora):"
        echo "$paused"
    fi
}

