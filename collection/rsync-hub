#!/usr/bin/env bash
# rsync-hub — coleta CARBONARA por rsync-over-SSH: o lado HOST (servidor central).
#
# Papéis deste arquivo:
#   1) Instalação guiada — `install` conduz passo a passo: pasta raiz dos dados, conta
#      de serviço e, na sequência, a autorização das estações (clientes).
#   2) Gerência   — autoriza/remove/lista estações (menu interativo ou comando direto).
#   3) Monitor    — modo que fica rodando mostrando quem conectou e o que chegou.
#   4) Comando forçado — cada estação, ao conectar por SSH, cai em `rsync-hub serve <id>`,
#      que confina o rsync à pasta daquela estação (write-only).
#
# O lado CLIENTE (estações Linux/Windows) fica em collection/station/carbonara-station.sh e
# collection/station/carbonara-station.ps1 — assistentes guiados que geram a chave, testam e
# agendam o envio. Rode `rsync-hub cliente` para ver as instruções passo a passo.
#
# Isolamento (simples, mas real): cada estação tem uma CHAVE que só executa este script
# com o SEU id; o `restrict` no authorized_keys corta shell/túnel/PTY; e o `rrsync -wo`
# tranca o rsync na pasta da estação, em modo só-escrita (envia, não baixa nem lê as
# outras). Uma conta de serviço única dona das pastas — sem criar usuário por estação.
#
# Uso:
#   sudo ./rsync-hub install             # instalação GUIADA do host (pastas+conta+estações)
#   sudo ./rsync-hub install --defaults  # instalação sem perguntas (usa defaults/ambiente)
#   sudo ./rsync-hub add <id>            # autoriza GERANDO a chave aqui (stations/<id>/
#                                        #   guarda o par + INSTRUCOES.txt de ativação)
#   sudo ./rsync-hub add <id> <pub>      # autoriza com chave pública já existente
#   sudo ./rsync-hub add <id> --senha    # autoriza por USUÁRIO+SENHA (rsync daemon:873;
#                                        #   simples no cliente, dados sem criptografia)
#   sudo ./rsync-hub remove <id>         # revoga o acesso da estação
#        ./rsync-hub list                # lista estações autorizadas
#        ./rsync-hub monitor             # fica rodando, mostrando as conexões (Ctrl-C sai)
#        ./rsync-hub status              # mostra o status uma vez
#        ./rsync-hub cliente             # como configurar uma estação (cliente)
#        ./rsync-hub                     # abre o menu interativo
#
# Configuração: o `install` grava as escolhas em /etc/rsync-hub.conf; variáveis de
# ambiente (CARBONARA_ROOT, HUB_USER, RRSYNC) têm precedência sobre o arquivo.
set -eu

# Bump a cada mudança de comportamento — é como se detecta uma cópia instalada
# defasada em /usr/local/bin (compare `rsync-hub help` com o script do repositório).
RSYNC_HUB_VERSION="2026-07-23.1"

# --- Configuração: defaults ← /etc/rsync-hub.conf ← ambiente ---------------------
ENV_BASE="${CARBONARA_ROOT:-}"; ENV_HUB_USER="${HUB_USER:-}"; ENV_RRSYNC="${RRSYNC:-}"
CONF_FILE="${RSYNC_HUB_CONF:-/etc/rsync-hub.conf}"
BASE=""; HUB_USER=""; RRSYNC=""
[ -r "$CONF_FILE" ] && . "$CONF_FILE"
BASE="${ENV_BASE:-${BASE:-/srv/carbonara}}"          # raiz dos dados no host
HUB_USER="${ENV_HUB_USER:-${HUB_USER:-carbonara}}"   # conta de serviço única que recebe os envios
RRSYNC="${ENV_RRSYNC:-${RRSYNC:-/usr/bin/rrsync}}"   # wrapper restrito que acompanha o rsync
REFRESH="${RSYNC_HUB_REFRESH:-3}"                    # segundos entre atualizações do monitor
STALE_AFTER="${RSYNC_HUB_STALE:-3600}"               # sem atividade > isto (s) => estação "MUDA"
SELF=""                                              # caminho a gravar no authorized_keys (ver install)

RSYNCD_PORT="${RSYNCD_PORT:-873}"            # porta do modo usuário+senha (rsync daemon)

derive_paths() {
    INCOMING="$BASE/incoming"                # uma subpasta por estação
    LOG="$BASE/log/connections.log"          # registro de conexões (texto simples)
    AUTHKEYS="$BASE/.ssh/authorized_keys"    # chaves das estações (fora do alcance delas)
    RSYNCD_CONF="$BASE/rsyncd.conf"          # módulos do modo usuário+senha (gerado)
    RSYNCD_SECRETS="$BASE/rsyncd.secrets"    # credenciais id:senha (644, fonte da verdade)
    RSYNCD_LOG="$BASE/log/rsyncd.log"
}
derive_paths

die()      { echo "erro: $*" >&2; exit 1; }
need_root(){ [ "$(id -u)" = 0 ] || die "execute como root (sudo)"; }
is_root()  { [ "$(id -u)" = 0 ]; }
is_tty()   { [ -t 0 ] && [ -t 1 ]; }
valid_id() { echo "$1" | grep -Eq '^[a-z0-9][a-z0-9_]{1,30}$' \
                || die "id inválido: '$1' (use minúsculas, dígitos e '_')"; }
self_path(){ [ -n "$SELF" ] && { echo "$SELF"; return; }
             readlink -f "$0" 2>/dev/null || echo "$0"; }
host_addr(){ hostname -I 2>/dev/null | awk 'NF{print $1; exit}' | grep . || hostname; }

ask() { # $1=pergunta $2=default → ecoa a resposta (Enter aceita o default)
    if [ -n "${2:-}" ]; then printf '%s [%s]: ' "$1" "$2" >&2; else printf '%s: ' "$1" >&2; fi
    read -r a || a=""
    if [ -n "$a" ]; then printf '%s\n' "$a"; else printf '%s\n' "${2:-}"; fi
}
ask_yn() { # $1=pergunta $2=default (s|n) → rc 0 = sim
    d="${2:-s}"
    if [ "$d" = s ]; then h="S/n"; else h="s/N"; fi
    printf '%s [%s]: ' "$1" "$h" >&2
    read -r a || a=""
    a="${a:-$d}"
    case "$a" in s|S|y|Y|sim|Sim|SIM) return 0 ;; *) return 1 ;; esac
}

# --- Papel 4: comando forçado (o sshd chama isto; não é para uso manual) ---------
serve() {
    station="${1:-}"; [ -n "$station" ] || exit 1
    ts="$(date -u +%FT%TZ)"; ip="${SSH_CLIENT%% *}"
    # Só aceita rsync em modo servidor; qualquer outra coisa é barrada e registrada.
    case "${SSH_ORIGINAL_COMMAND:-}" in
        "rsync --server "*) : ;;
        *) echo "$ts REJECT $station $ip ${SSH_ORIGINAL_COMMAND:-}" >>"$LOG" 2>/dev/null || true
           echo "rsync-hub: somente rsync (envio) é permitido." >&2; exit 128 ;;
    esac
    echo "$ts CONNECT $station $ip" >>"$LOG" 2>/dev/null || true
    rc=0; "$RRSYNC" -wo "$INCOMING/$station" || rc=$?   # -wo = write-only, confinado à pasta
    echo "$(date -u +%FT%TZ) DISCONNECT $station $ip" >>"$LOG" 2>/dev/null || true
    exit "$rc"
}

# --- Papel 1: instalação -----------------------------------------------------------
find_rrsync() {
    for c in "$RRSYNC" /usr/bin/rrsync /usr/local/bin/rrsync; do
        [ -x "$c" ] && { RRSYNC="$c"; return 0; }
    done
    if command -v rrsync >/dev/null 2>&1; then RRSYNC="$(command -v rrsync)"; return 0; fi
    return 1
}

create_host() {   # o miolo do install: conta de serviço + pastas + arquivos
    id "$HUB_USER" >/dev/null 2>&1 || \
        useradd --system --home-dir "$BASE" --create-home --shell /bin/sh "$HUB_USER"
    passwd -l "$HUB_USER" >/dev/null 2>&1 || true      # tranca a senha: só chave
    install -d -m 755 -o "$HUB_USER" -g "$HUB_USER" "$BASE" "$INCOMING" "$BASE/log"
    # .ssh 755 e authorized_keys 644: o sshd (StrictModes) só exige que NÃO sejam
    # graváveis por grupo/outros — leitura aberta é permitida e é a política do host.
    install -d -m 755 -o "$HUB_USER" -g "$HUB_USER" "$BASE/.ssh"
    install -d -m 755 "$BASE/stations"
    touch "$LOG"; chown "$HUB_USER:$HUB_USER" "$LOG"; chmod 644 "$LOG"
    touch "$AUTHKEYS"; chown "$HUB_USER:$HUB_USER" "$AUTHKEYS"; chmod 644 "$AUTHKEYS"
    # Política de LEITURA do host: os usuários locais podem VER tudo (dados, chaves,
    # credenciais/instruções, lista de estações) sem sudo — mas nada é gravável por
    # eles. A segurança de ESCRITA continua valendo para as estações (forced command +
    # rrsync/módulo write-only). Normaliza também instalações antigas:
    chmod -R u+rwX,go+rX "$BASE/stations" 2>/dev/null || true
    if [ -f "$RSYNCD_SECRETS" ]; then
        chmod 644 "$RSYNCD_SECRETS"
        rebuild_rsyncd_conf
    fi
}

save_conf() {     # persiste as escolhas para os próximos usos (inclusive o serve via sshd)
    if { echo "# gerado por 'rsync-hub install' em $(date -u +%FT%TZ)"
         echo "BASE=$BASE"
         echo "HUB_USER=$HUB_USER"
         echo "RRSYNC=$RRSYNC"; } > "$CONF_FILE" 2>/dev/null; then
        chmod 644 "$CONF_FILE"
        echo "configuração gravada em $CONF_FILE."
    else
        echo "aviso: não consegui gravar $CONF_FILE — defina CARBONARA_ROOT/HUB_USER no ambiente."
    fi
}

install_host() {
    need_root
    # Sem terminal (ou com --defaults): comportamento direto, sem perguntas.
    if [ "${1:-}" = "--defaults" ] || ! is_tty; then
        find_rrsync || echo "aviso: 'rrsync' não encontrado — instale o pacote 'rsync'."
        create_host; save_conf
        echo "host preparado: conta '$HUB_USER', pastas em $BASE."
        echo "instale o script no PATH, ex.: sudo install -m 755 $(self_path) /usr/local/bin/rsync-hub"
        return 0
    fi

    echo
    echo "===== Instalação guiada do host (servidor central) ====="
    echo "Este assistente prepara ESTA máquina para receber os dados das estações:"
    echo "  passo 1 — pasta raiz onde os arquivos vão chegar;"
    echo "  passo 2 — conta de serviço (recebe todos os envios; senha travada, só chave);"
    echo "  passo 3 — autorização das estações (clientes) que vão se conectar."
    echo

    # Passo 1/3 — pasta raiz
    echo "--- Passo 1/3: pasta raiz dos dados ---"
    echo "Tudo chega em <raiz>/incoming/<estação>/; a ingestão lê dali."
    while :; do
        b="$(ask "Pasta raiz dos dados" "$BASE")"
        case "$b" in
            /*) BASE="$b"; break ;;
            *)  echo "  use um caminho absoluto (começando com /)." ;;
        esac
    done
    derive_paths
    HUB_USER="$(ask "Conta de serviço (será criada se não existir)" "$HUB_USER")"
    rrsync_txt="$RRSYNC"
    if ! find_rrsync; then
        rrsync_txt="NÃO ENCONTRADO"
        echo "  aviso: 'rrsync' não foi encontrado — ele acompanha o pacote 'rsync' e é"
        echo "         obrigatório para RECEBER os envios (as pastas podem ser criadas já)."
        echo "         instale com: sudo apt-get install rsync   (ou o equivalente da distro)"
        if ! ask_yn "  Continuar mesmo assim (só cria conta e pastas)?" n; then
            echo
            echo "*** INSTALAÇÃO CANCELADA — NADA FOI CRIADO. ***"
            echo "instale o rsync e rode de novo: sudo rsync-hub install"
            return 1
        fi
    else
        rrsync_txt="$RRSYNC"
    fi
    echo
    echo "Resumo: raiz=$BASE · conta=$HUB_USER · rrsync=$rrsync_txt"
    if ! ask_yn "Confirmar e criar?" s; then
        echo
        echo "*** INSTALAÇÃO CANCELADA — NADA FOI CRIADO. ***"
        return 1
    fi
    create_host
    save_conf
    echo "ok: host preparado (conta '$HUB_USER'). Pastas criadas:"
    echo "    $INCOMING    ← os dados chegam aqui (uma subpasta por estação)"
    echo "    $BASE/log    ← registro de conexões"
    echo "    $BASE/.ssh   ← chaves das estações (authorized_keys)"
    echo

    # Passo 2/3 — script no PATH (o authorized_keys aponta para este caminho)
    echo "--- Passo 2/3: instalar o script no PATH ---"
    if [ "$(self_path)" != "/usr/local/bin/rsync-hub" ]; then
        if ask_yn "Copiar para /usr/local/bin/rsync-hub (recomendado)?" s; then
            install -m 755 "$(self_path)" /usr/local/bin/rsync-hub
            SELF="/usr/local/bin/rsync-hub"
            echo "ok: daqui em diante chame apenas 'rsync-hub', de qualquer pasta."
        else
            echo "ok — as chaves das estações vão apontar para $(self_path); não mova o arquivo."
        fi
    else
        echo "já está em /usr/local/bin/rsync-hub."
    fi
    echo

    # Passo 3/3 — autorizar estações
    echo "--- Passo 3/3: autorizar as estações (clientes) ---"
    echo "O mais simples é GERAR a chave de cada estação aqui mesmo (aperte ENTER na"
    echo "pergunta da chave): ela fica em $BASE/stations/<id>/ junto com um"
    echo "INSTRUCOES.txt de ativação — você leva a chave privada para a estação."
    echo "Se a estação já tem chave própria, informe o arquivo .pub ou cole a linha."
    echo "Dá para adicionar estações depois também (sudo rsync-hub add <id>)."
    while ask_yn "Adicionar uma estação agora?" s; do
        add_station_wizard || echo "  (estação não adicionada — tente de novo)"
    done

    echo
    echo "===== Instalação concluída — próximos passos ====="
    echo "  - em cada estação, rode o assistente do cliente apontando para este host:"
    echo "      endereço: $(host_addr) · porta: 22 · conta: $HUB_USER"
    echo "    (instruções completas: rsync-hub cliente)"
    [ "$BASE" != "/srv/carbonara" ] && \
        echo "  - use CARBONARA_ROOT=$BASE no .env do docker compose (mesma raiz da coleta)."
    echo "  - acompanhe as chegadas com: rsync-hub monitor"
}

# --- Papel 2: gerência -------------------------------------------------------------
write_instructions() {  # $1=id $2=pasta da estação — gera o INSTRUCOES.txt de ativação
    wi_id="$1"; wi_dir="$2"; wi_addr="$(host_addr)"
    cat > "$wi_dir/INSTRUCOES.txt" <<EOF
CARBONARA — ativação da estação '$wi_id'
========================================
(gerado por rsync-hub em $(date -u +%FT%TZ))

Servidor (host): $wi_addr · porta: 22 (padrão) · conta: $HUB_USER

1) Copie para a máquina da estação:
     - a chave privada desta pasta:  ${wi_id}_key   (mantenha-a protegida!)
     - o cliente (pasta collection/station/ do repositório carbonara-datahub):
         Linux:    carbonara-station.sh
         Windows:  carbonara-station.ps1 + carbonara-station.cmd

2) Na estação, rode o assistente guiado:
         Linux:    ./carbonara-station.sh setup
         Windows:  .\\carbonara-station.cmd setup
                   (na 1ª vez o assistente instala o rsync (cwRsync) sozinho —
                    abra o PowerShell COMO ADMINISTRADOR só nessa primeira vez)
   Ele pergunta, nesta ordem:
     - id da estação ................ $wi_id
     - IP do host ................... $wi_addr   (porta: 22, se não foi alterada)
     - caminho local da chave ....... onde você salvou o arquivo ${wi_id}_key
     → teste simples de conexão (o host responde? a chave é aceita?)
     - pasta local a enviar (rsync)
     - tempo de reciclagem (minutos) + ativação do envio automático

3) Pronto. Acompanhe as chegadas no servidor com:  rsync-hub monitor

Observações:
  - A chave pública (${wi_id}_key.pub) permanece nesta pasta e já está autorizada.
  - Para revogar o acesso desta estação:  sudo rsync-hub remove $wi_id
EOF
    chmod 644 "$wi_dir/INSTRUCOES.txt"
}

# --- Modo usuário+senha: rsync daemon (porta 873) -----------------------------------
# Alternativa às chaves para estações onde a chave complica: o rsync daemon tem
# autenticação própria (usuário=id da estação, senha desafio-resposta — a senha não
# trafega em claro) e cada estação vira um módulo confinado à sua pasta, write-only e
# com --delete recusado. ATENÇÃO: os DADOS trafegam sem criptografia — para redes
# públicas, prefira o modo chave SSH.
gen_password() { LC_ALL=C tr -dc 'a-z0-9' </dev/urandom | head -c 12; }

rebuild_rsyncd_conf() {   # regenera o rsyncd.conf inteiro a partir do secrets
    {
        echo "# gerado por rsync-hub em $(date -u +%FT%TZ) — NÃO edite (regenerado no add/remove)"
        echo "uid = $HUB_USER"
        echo "gid = $HUB_USER"
        echo "use chroot = true"
        # strict modes = false: permite o rsyncd.secrets 644 (política de leitura
        # aberta do host — sem isso o daemon recusa um secrets legível por todos).
        echo "strict modes = false"
        echo "pid file = $BASE/rsyncd.pid"
        echo "lock file = $BASE/rsyncd.lock"
        echo "log file = $RSYNCD_LOG"
        echo "port = $RSYNCD_PORT"
        while IFS=: read -r sid _; do
            [ -n "$sid" ] || continue
            echo
            echo "[$sid]"
            echo "    path = $INCOMING/$sid"
            echo "    comment = estacao CARBONARA $sid (write-only)"
            echo "    auth users = $sid"
            echo "    secrets file = $RSYNCD_SECRETS"
            echo "    read only = false"
            echo "    write only = true"
            echo "    refuse options = delete* remove-source-files"
            echo "    max connections = 4"
            echo "    timeout = 600"
        done < "$RSYNCD_SECRETS"
    } > "$RSYNCD_CONF"
    chmod 644 "$RSYNCD_CONF"
}

open_firewall_port() {  # tenta liberar a porta do rsyncd no firewall DO HOST
    if command -v ufw >/dev/null 2>&1 && ufw status 2>/dev/null | grep -q "Status: active"; then
        if ufw allow "$RSYNCD_PORT/tcp" >/dev/null 2>&1; then
            echo "ok: porta $RSYNCD_PORT/tcp liberada no firewall do host (ufw)."
        else
            echo "aviso: não consegui liberar a porta $RSYNCD_PORT no ufw — libere manualmente."
        fi
    elif command -v firewall-cmd >/dev/null 2>&1 && firewall-cmd --state >/dev/null 2>&1; then
        if firewall-cmd --permanent --add-port="$RSYNCD_PORT/tcp" >/dev/null 2>&1 \
           && firewall-cmd --reload >/dev/null 2>&1; then
            echo "ok: porta $RSYNCD_PORT/tcp liberada no firewall do host (firewalld)."
        else
            echo "aviso: não consegui liberar a porta $RSYNCD_PORT no firewalld — libere manualmente."
        fi
    else
        echo "(nenhum firewall gerenciável detectado no host — ufw/firewalld inativos ou ausentes.)"
    fi
}

rsyncd_listening() {  # o daemon está escutando na porta?
    if command -v ss >/dev/null 2>&1; then
        ss -ltn 2>/dev/null | grep -q ":$RSYNCD_PORT "
    elif command -v netstat >/dev/null 2>&1; then
        netstat -ltn 2>/dev/null | grep -q ":$RSYNCD_PORT "
    else
        return 0    # sem como checar: não alarma
    fi
}

ensure_rsyncd() {   # deixa o daemon no ar (config e senhas são relidos a cada conexão)
    rebuild_rsyncd_conf
    if command -v systemctl >/dev/null 2>&1 && [ -d /etc/systemd/system ]; then
        cat > /etc/systemd/system/carbonara-rsyncd.service <<EOF
[Unit]
Description=CARBONARA rsync daemon (estações com usuário+senha)
After=network.target

[Service]
ExecStart=$(command -v rsync) --daemon --no-detach --config=$RSYNCD_CONF
Restart=on-failure

[Install]
WantedBy=multi-user.target
EOF
        systemctl daemon-reload
        systemctl enable --now carbonara-rsyncd >/dev/null 2>&1 || true
        systemctl is-active carbonara-rsyncd >/dev/null 2>&1 || \
            echo "aviso: o serviço carbonara-rsyncd não subiu — veja: systemctl status carbonara-rsyncd"
    else
        # Sem systemd: sobe direto se ainda não estiver rodando (pid file).
        if ! { [ -f "$BASE/rsyncd.pid" ] && kill -0 "$(cat "$BASE/rsyncd.pid" 2>/dev/null)" 2>/dev/null; }; then
            rsync --daemon --config="$RSYNCD_CONF" || echo "aviso: falha ao subir o rsync --daemon"
        fi
    fi
}

write_instructions_pw() {  # $1=id $2=pasta da estação $3=senha
    wp_id="$1"; wp_dir="$2"; wp_pw="$3"; wp_addr="$(host_addr)"
    cat > "$wp_dir/INSTRUCOES.txt" <<EOF
CARBONARA — ativação da estação '$wp_id' (modo USUÁRIO+SENHA)
=============================================================
(gerado por rsync-hub em $(date -u +%FT%TZ))

Servidor (host): $wp_addr · porta: $RSYNCD_PORT (rsync direto, sem SSH)
Credenciais:     usuário: $wp_id   ·   senha: $wp_pw
                 (guarde este arquivo com cuidado — a senha está nele)

1) Copie o cliente para a máquina da estação (pasta collection/station/ do repositório
   carbonara-datahub):
       Linux:    carbonara-station.sh
       Windows:  carbonara-station.ps1 + carbonara-station.cmd

2) Na estação, rode o assistente guiado:
       Linux:    ./carbonara-station.sh setup
       Windows:  .\\carbonara-station.cmd setup
                 (na 1ª vez o assistente instala o rsync (cwRsync) sozinho —
                  abra o PowerShell COMO ADMINISTRADOR só nessa primeira vez)
   Ele pergunta, nesta ordem:
     - id da estação ................ $wp_id
     - IP do host ................... $wp_addr
     - autenticação ................. escolha "usuário e senha"
     - porta ........................ $RSYNCD_PORT (padrão desse modo)
     - senha ........................ a senha acima
     → teste simples de conexão (o host responde? a senha confere?)
     - pasta local a enviar (rsync)
     - tempo de reciclagem (minutos) + ativação do envio automático

3) Pronto. Acompanhe as chegadas no servidor com:  rsync-hub monitor

Observações:
  - Este modo NÃO usa a porta do SSH: a porta $RSYNCD_PORT/tcp precisa estar aberta em
    todo o caminho estação→servidor (firewall do host E firewall/roteador externo).
    Teste rápido, de qualquer máquina:  rsync rsync://$wp_addr:$RSYNCD_PORT/
    (deve responder listando os módulos). Se a porta não puder ser aberta, peça ao
    administrador o modo CHAVE (porta 22).
  - A estação só escreve na própria pasta (incoming/$wp_id), em modo write-only,
    e o servidor recusa --delete: ela não lê, não baixa e não apaga nada.
  - O tráfego NÃO é criptografado (a senha não circula em claro, os dados sim).
    Em redes públicas, prefira o modo chave SSH.
  - Para revogar o acesso:  sudo rsync-hub remove $wp_id
EOF
    # Legível pelos usuários locais do host (política de leitura aberta) — a senha da
    # estação está aqui e o rsyncd.secrets é 644 (strict modes desativado no daemon).
    chmod 644 "$wp_dir/INSTRUCOES.txt"
}

add_station_pw() {   # $1=id $2=senha (vazio = gerar)
    need_root
    id="${1:-}"; pw="${2:-}"
    [ -n "$id" ] || die "uso: rsync-hub add <id> --senha [senha]"
    valid_id "$id"
    [ -d "$BASE" ] || die "host não preparado — rode antes: sudo rsync-hub install"
    command -v rsync >/dev/null 2>&1 || die "'rsync' não encontrado no host"
    [ -n "$pw" ] || pw="$(gen_password)"
    [ -n "$pw" ] || die "falha ao gerar a senha"
    case "$pw" in *:*|*' '*) die "senha não pode conter ':' nem espaço" ;; esac
    install -d -m 755 -o "$HUB_USER" -g "$HUB_USER" "$INCOMING/$id"
    touch "$RSYNCD_SECRETS"; chmod 644 "$RSYNCD_SECRETS"
    grep -v "^$id:" "$RSYNCD_SECRETS" > "$RSYNCD_SECRETS.tmp" 2>/dev/null || true
    printf '%s:%s\n' "$id" "$pw" >> "$RSYNCD_SECRETS.tmp"
    mv "$RSYNCD_SECRETS.tmp" "$RSYNCD_SECRETS"; chmod 644 "$RSYNCD_SECRETS"
    ensure_rsyncd
    open_firewall_port
    keydir="$BASE/stations/$id"
    install -d -m 755 "$keydir"
    write_instructions_pw "$id" "$keydir" "$pw"
    echo "estação '$id' autorizada por USUÁRIO+SENHA (pasta $INCOMING/$id, write-only, sem delete)."
    echo "    usuário: $id"
    echo "    senha:   $pw"
    echo "    porta:   $RSYNCD_PORT"
    echo "    INSTRUCOES.txt (com a senha) em: $keydir/"
    if rsyncd_listening; then
        echo "ok: o daemon está escutando na porta $RSYNCD_PORT deste host."
    else
        echo "AVISO: não vi o daemon escutando na porta $RSYNCD_PORT — confira:"
        echo "       systemctl status carbonara-rsyncd   ·   ss -ltn | grep $RSYNCD_PORT"
    fi
    echo
    echo "IMPORTANTE — este modo NÃO usa a porta do SSH: a porta $RSYNCD_PORT/tcp precisa estar"
    echo "aberta em TODO o caminho até a estação (firewall do host: tentei liberar acima;"
    echo "firewall externo/roteador da instituição: peça a liberação). Teste de qualquer"
    echo "máquina:  rsync rsync://$(host_addr):$RSYNCD_PORT/   (deve listar os módulos)."
    echo "Se a porta $RSYNCD_PORT não puder ser aberta, use o modo CHAVE (porta 22):"
    echo "    sudo rsync-hub add $id"
    echo
    echo "atenção: tráfego SEM criptografia (dados em claro; a senha, não)."
}

add_station() {
    need_root
    id="${1:-}"; pub="${2:-}"
    [ -n "$id" ] || die "uso: rsync-hub add <id> [arquivo_chave_publica]  (sem o arquivo, a chave é gerada aqui)"
    valid_id "$id"
    [ -f "$AUTHKEYS" ] || die "host não preparado — rode antes: sudo rsync-hub install"

    generated=""
    if [ -z "$pub" ]; then
        # Sem chave informada: gera o par AQUI e o guarda na pasta da estação
        # ($BASE/stations/<id> — fora do incoming/, que a estação pode escrever e a
        # ingestão varre), junto com as instruções de ativação. O operador leva a
        # chave privada para a estação.
        keydir="$BASE/stations/$id"
        install -d -m 755 "$keydir"
        key="$keydir/${id}_key"
        if [ ! -f "$key.pub" ]; then
            ssh-keygen -q -t ed25519 -N "" -C "carbonara-$id" -f "$key" || die "falha ao gerar a chave"
        fi
        # Legíveis pelos usuários locais do host (política de leitura aberta: o
        # administrador copia a chave para o operador SEM sudo).
        chmod 644 "$key" "$key.pub"
        pub="$key.pub"; generated=1
    fi
    [ -f "$pub" ] || die "chave pública não encontrada: $pub"
    ssh-keygen -l -f "$pub" >/dev/null 2>&1 || die "não parece uma chave pública SSH: $pub"

    install -d -m 755 -o "$HUB_USER" -g "$HUB_USER" "$INCOMING/$id"
    # O comando forçado do authorized_keys precisa de um caminho que a conta de
    # serviço consiga EXECUTAR para sempre — um script dentro de /home/<admin>/ falha
    # com "Permission denied" (homes são 750). Garante a cópia estável em
    # /usr/local/bin e aponta a chave para ela.
    if [ "$(self_path)" != /usr/local/bin/rsync-hub ]; then
        install -m 755 "$(self_path)" /usr/local/bin/rsync-hub
        SELF=/usr/local/bin/rsync-hub
        echo "script instalado/atualizado em /usr/local/bin/rsync-hub (a chave aponta para lá)."
    fi
    # Remove entrada antiga da mesma estação (se houver) e adiciona a nova.
    grep -vF "serve $id\"" "$AUTHKEYS" > "$AUTHKEYS.tmp" 2>/dev/null || true
    printf 'command="%s serve %s",restrict %s\n' "$(self_path)" "$id" "$(cat "$pub")" >> "$AUTHKEYS.tmp"
    mv "$AUTHKEYS.tmp" "$AUTHKEYS"; chown "$HUB_USER:$HUB_USER" "$AUTHKEYS"; chmod 644 "$AUTHKEYS"
    echo "estação '$id' autorizada (pasta $INCOMING/$id)."
    if [ -n "$generated" ]; then
        write_instructions "$id" "$keydir"
        echo "chave da estação gerada e guardada em $keydir/:"
        echo "    ${id}_key        ← COPIE para a máquina da estação (chave privada)"
        echo "    ${id}_key.pub    ← permanece aqui (já autorizada)"
        echo "    INSTRUCOES.txt   ← passo a passo de ativação, para acompanhar a chave"
        echo "(arquivos legíveis pelos usuários locais do host — a cópia dispensa sudo.)"
    else
        echo "no cliente, aponte para: conta $HUB_USER · host $(host_addr) · porta 22 (detalhes: rsync-hub cliente)"
    fi
}

add_station_wizard() {  # versão guiada do add: escolhe o modo de autenticação
    id="$(ask "  id da estação (minúsculas/dígitos/_ , ex.: flona01)" "")"
    [ -n "$id" ] || { echo "  id vazio."; return 1; }
    echo "$id" | grep -Eq '^[a-z0-9][a-z0-9_]{1,30}$' || { echo "  id inválido."; return 1; }
    echo "  como a estação vai se autenticar?"
    echo "    1) chave SSH (recomendado — tráfego criptografado, usa a porta 22 já aberta)"
    echo "    2) usuário e senha (mais simples no cliente — MAS exige a porta $RSYNCD_PORT/tcp"
    echo "       aberta até a estação, além da 22; dados SEM criptografia)"
    modo="$(ask "  modo" "1")"
    if [ "$modo" = 2 ]; then
        pw="$(ask "  senha (ENTER = gerar uma)" "")"
        if ( add_station_pw "$id" "$pw" ); then return 0; else return 1; fi
    fi
    echo "  chave pública da estação: aperte ENTER para GERAR o par aqui no host"
    echo "  (fica em $BASE/stations/$id/ com as instruções de ativação), OU informe o"
    echo "  CAMINHO de um arquivo .pub, OU cole a linha inteira ('ssh-ed25519 …')."
    printf '  chave (ENTER = gerar aqui)> '
    read -r key || return 1
    tmp=""
    case "$key" in
        "")                 pub="" ;;
        ssh-*|ecdsa-*|sk-*) tmp="$(mktemp)"; printf '%s\n' "$key" > "$tmp"; pub="$tmp" ;;
        *)                  pub="$key" ;;
    esac
    # Subshell: um erro no add não derruba o assistente.
    if [ -z "$pub" ]; then
        if ( add_station "$id" ); then rc=0; else rc=1; fi
    else
        if ( add_station "$id" "$pub" ); then rc=0; else rc=1; fi
    fi
    [ -n "$tmp" ] && rm -f "$tmp"
    return "$rc"
}

remove_station() {
    need_root
    id="${1:-}"; [ -n "$id" ] || die "uso: rsync-hub remove <id>"
    valid_id "$id"
    revoked=0
    if [ -f "$AUTHKEYS" ] && grep -qF "serve $id\"" "$AUTHKEYS"; then
        grep -vF "serve $id\"" "$AUTHKEYS" > "$AUTHKEYS.tmp" || true
        mv "$AUTHKEYS.tmp" "$AUTHKEYS"; chown "$HUB_USER:$HUB_USER" "$AUTHKEYS"; chmod 644 "$AUTHKEYS"
        echo "estação '$id': acesso por CHAVE revogado."
        revoked=1
    fi
    if [ -f "$RSYNCD_SECRETS" ] && grep -q "^$id:" "$RSYNCD_SECRETS"; then
        grep -v "^$id:" "$RSYNCD_SECRETS" > "$RSYNCD_SECRETS.tmp" || true
        mv "$RSYNCD_SECRETS.tmp" "$RSYNCD_SECRETS"; chmod 644 "$RSYNCD_SECRETS"
        rebuild_rsyncd_conf
        echo "estação '$id': acesso por USUÁRIO+SENHA revogado."
        revoked=1
    fi
    if [ "$revoked" = 1 ]; then
        echo "dados preservados em $INCOMING/$id."
        [ -d "$BASE/stations/$id" ] && \
            echo "chaves/instruções mantidas em $BASE/stations/$id — apague a pasta se não for reativar."
    else
        echo "estação '$id' não estava autorizada."
    fi
}

list_stations() {
    any=0
    if [ -f "$AUTHKEYS" ] && grep -q 'serve ' "$AUTHKEYS"; then
        echo "estações por CHAVE SSH:"
        sed -n 's/.*serve \([^"]*\)".*/  - \1/p' "$AUTHKEYS" | sort
        any=1
    fi
    if [ -r "$RSYNCD_SECRETS" ] && grep -q ':' "$RSYNCD_SECRETS" 2>/dev/null; then
        echo "estações por USUÁRIO+SENHA (rsync daemon, porta $RSYNCD_PORT):"
        cut -d: -f1 "$RSYNCD_SECRETS" | sort | sed 's/^/  - /'
        any=1
    fi
    [ "$any" = 1 ] || echo "(nenhuma estação autorizada — use 'rsync-hub add')"
}

client_help() {
    addr="$(host_addr)"
    cat <<EOF

===== Como configurar uma estação (cliente) =====

Dados DESTE host para informar no assistente do cliente:
    endereço: $addr · porta: 22 · conta de serviço: $HUB_USER

O jeito mais simples (chave gerada AQUI no host):
    1. sudo rsync-hub add <id>          # sem arquivo: gera o par da estação
       → cria $BASE/stations/<id>/ com a chave privada (<id>_key), a pública
         (que permanece lá, já autorizada) e um INSTRUCOES.txt de ativação.
    2. leve para a estação: a chave privada <id>_key + o cliente da pasta
       collection/station/ (Linux: carbonara-station.sh · Windows: carbonara-station.ps1
       e carbonara-station.cmd, na mesma pasta).
    3. na estação, rode o assistente:
           Linux:    ./carbonara-station.sh setup
           Windows:  .\\carbonara-station.cmd setup
       (Windows, 1ª vez: o assistente baixa e instala o rsync (cwRsync) em
        C:\\cwrsync — abra o PowerShell COMO ADMINISTRADOR só nessa vez)
       ele pergunta, nesta ordem: id da estação → IP do host ($addr, porta 22)
       → caminho local da chave → TESTE de conexão → pasta a enviar (rsync)
       → tempo de reciclagem (minutos) + ativação do envio automático.

Alternativa (chave gerada NA estação):
    - na estação, o próprio setup oferece gerar um novo par quando a chave
      informada não existe; traga a PÚBLICA para cá e autorize com
          sudo rsync-hub add <id> <chave.pub>
      (ou cole a linha no menu → "Adicionar estação").

Alternativa SEM chave (usuário+senha — a mais simples no cliente):
    1. sudo rsync-hub add <id> --senha       # cria usuário=<id> e gera a senha
       → INSTRUCOES.txt (com a senha) em $BASE/stations/<id>/
    2. na estação, no setup, escolha "usuário e senha" e informe IP, porta $RSYNCD_PORT
       e a senha — sem arquivo de chave nenhum.
    Atenção: rsync direto na porta $RSYNCD_PORT (libere no firewall); a senha não
    trafega em claro, mas os DADOS sim — prefira chave em redes públicas.

Envio manual (sem o script do cliente):
    chave:  rsync -avz -e "ssh -i /caminho/<id>_key" /pasta/dos/dados/ $HUB_USER@$addr:/
    senha:  RSYNC_PASSWORD=<senha> rsync -avz /pasta/dos/dados/ rsync://<id>@$addr:$RSYNCD_PORT/<id>/
EOF
}

# --- Papel 3: status / monitor -----------------------------------------------------
# Estados (bolinha colorida por estação):
#   ● roxo    "Recebendo dados" — sessão SSH aberta agora OU arquivos chegando (<60s)
#   ● verde   "Online"          — sinal de vida/atividade dentro da janela da estação
#   ● vermelho"Offline"         — sem sinal além da janela (ou nunca conectou)
#
# A janela é POR ESTAÇÃO: o cliente envia a cada ciclo o arquivo oculto
# .carbonara-status (sinal de vida) declarando o seu tempo de reciclagem
# (interval_min); consideramos Offline após 2 ciclos + 2 min sem sinal. O horário
# usado é o mtime de CHEGADA do arquivo (o envio não preserva o mtime da origem),
# imune a fuso/relógio da estação. Estações sem sinal de vida (clientes antigos)
# caem no limite global RSYNC_HUB_STALE (padrão 1h).
print_status() {
    now="$(date +%s)"
    if [ -t 1 ]; then
        C_ON=$'\033[32m'; C_OFF=$'\033[31m'; C_RX=$'\033[35m'; C_0=$'\033[0m'
    else
        C_ON=""; C_OFF=""; C_RX=""; C_0=""
    fi
    printf '  %-16s %-18s %-22s %-8s %s\n' "ESTAÇÃO" "STATUS" "ÚLTIMO SINAL (local)" "CICLO" "PASTA"
    if [ ! -d "$INCOMING" ]; then echo "(sem pasta $INCOMING — rode 'install')"; return; fi
    found=0
    for d in "$INCOMING"/*/; do
        [ -d "$d" ] || continue
        found=1
        id="$(basename "$d")"
        lastfile="$(find "$d" -type f ! -name '.*' -not -path '*/.*' -printf '%T@\n' 2>/dev/null | sort -nr | head -1)"
        lastfile="${lastfile%.*}"
        lastconn="$(grep " CONNECT $id " "$LOG" 2>/dev/null | tail -1 | awk '{print $1}')"
        lastconn_epoch=""
        [ -n "$lastconn" ] && lastconn_epoch="$(date -u -d "$lastconn" +%s 2>/dev/null || echo '')"
        # Sinal de vida da estação: chegada do .carbonara-status + ciclo declarado.
        hb="$d/.carbonara-status"
        hb_epoch=""; interval=""
        if [ -f "$hb" ]; then
            hb_epoch="$(stat -c %Y "$hb" 2>/dev/null || stat -f %m "$hb" 2>/dev/null || echo '')"
            interval="$(sed -n 's/^interval_min=//p' "$hb" 2>/dev/null | head -1)"
            echo "$interval" | grep -Eq '^[0-9]+$' || interval=""
        fi
        act="0"
        [ -n "$lastfile" ] && [ "$lastfile" -gt "$act" ] 2>/dev/null && act="$lastfile"
        [ -n "$lastconn_epoch" ] && [ "$lastconn_epoch" -gt "$act" ] 2>/dev/null && act="$lastconn_epoch"
        [ -n "$hb_epoch" ] && [ "$hb_epoch" -gt "$act" ] 2>/dev/null && act="$hb_epoch"
        # Janela por estação: 2 ciclos + 2 min de folga; sem sinal de vida, o global.
        if [ -n "$interval" ]; then limit=$(( interval * 120 + 120 )); else limit="$STALE_AFTER"; fi
        # Recebendo agora? último evento SSH é um CONNECT sem DISCONNECT depois,
        # ou houve atividade (arquivo/conexão/sinal) nos últimos 60s.
        lastev="$(grep -E " (CONNECT|DISCONNECT) $id " "$LOG" 2>/dev/null | tail -1 | awk '{print $2}')"
        receiving=0
        [ "$lastev" = "CONNECT" ] && receiving=1
        [ "$act" != 0 ] && [ "$((now - act))" -le 60 ] && receiving=1
        if [ "$act" = 0 ]; then when="-"; else when="$(date -d "@$act" '+%F %T' 2>/dev/null || echo "$act")"; fi
        if [ -n "$interval" ]; then cyc="${interval} min"; else cyc="-"; fi
        if [ "$receiving" = 1 ]; then
            dot="${C_RX}●${C_0}"; txt="Recebendo dados"
        elif [ "$act" != 0 ] && [ "$((now - act))" -le "$limit" ]; then
            dot="${C_ON}●${C_0}"; txt="Online"
        else
            dot="${C_OFF}●${C_0}"; txt="Offline"
        fi
        printf '%s %-16s %-18s %-22s %-8s %s\n' "$dot" "$id" "$txt" "$when" "$cyc" "$INCOMING/$id"
    done
    [ "$found" = 1 ] || echo "(nenhuma estação com pasta ainda)"
}

# Converte, para EXIBIÇÃO, o 1º campo (carimbo UTC ISO gravado por serve()) de cada
# linha do log para a hora LOCAL do host — o arquivo em si continua em UTC.
fmt_log_local() {
    while IFS= read -r ln; do
        [ -n "$ln" ] || continue
        ts="${ln%% *}"; rest="${ln#* }"
        loc="$(date -d "$ts" '+%F %T' 2>/dev/null || echo "$ts")"
        printf '  %s %s\n' "$loc" "$rest"
    done
}

monitor() {
    trap 'echo; exit 0' INT
    while true; do
        clear 2>/dev/null || printf '\033[2J\033[H'
        echo "rsync-hub v$RSYNC_HUB_VERSION — monitor (atualiza a cada ${REFRESH}s · Ctrl-C sai)   $(date '+%F %T')"
        echo
        print_status
        echo
        echo "últimas conexões (chave SSH, hora local):"
        if [ -s "$LOG" ]; then
            tail -n 6 "$LOG" 2>/dev/null | fmt_log_local
        else
            echo "  (sem registros)"
        fi
        if [ -f "$RSYNCD_LOG" ]; then
            echo "últimas conexões (usuário+senha, rsync daemon):"
            tail -n 4 "$RSYNCD_LOG" 2>/dev/null | sed 's/^/  /'
        fi
        sleep "$REFRESH"
    done
}

# --- Menu interativo ---------------------------------------------------------------
menu() {
    while true; do
        echo
        echo "===== rsync-hub — servidor central (host) ====="
        echo " 1) Instalar/preparar este host (guiado)"
        echo " 2) Adicionar estação (guiado)"
        echo " 3) Remover estação"
        echo " 4) Listar estações"
        echo " 5) Status agora"
        echo " 6) Monitorar conexões (ao vivo)"
        echo " 7) Como configurar um cliente (estação)"
        echo " 0) Sair"
        printf "opção> "
        read -r op || exit 0
        case "$op" in
            1|2|3) if ! is_root; then echo "requer root — rode: sudo $(self_path)"; continue; fi ;;
        esac
        case "$op" in
            1) install_host || true ;;
            2) add_station_wizard || true ;;
            3) id="$(ask "id da estação" "")"
               [ -n "$id" ] || { echo "id vazio."; continue; }
               if ask_yn "revogar o acesso de '$id'? (os dados são preservados)" n; then
                   ( remove_station "$id" ) || true
               fi ;;
            4) list_stations ;;
            5) print_status ;;
            6) monitor ;;
            7) client_help ;;
            0|q|"") exit 0 ;;
            *) echo "opção inválida" ;;
        esac
    done
}

usage() {
    cat <<EOF
rsync-hub v$RSYNC_HUB_VERSION — coleta CARBONARA por rsync-over-SSH (lado HOST / servidor central)

uso:
  sudo rsync-hub install             instalação GUIADA (pasta raiz + conta + estações)
  sudo rsync-hub install --defaults  instalação sem perguntas (defaults/ambiente)
  sudo rsync-hub add <id>            autoriza uma estação GERANDO a chave aqui no host
                                     (fica em <raiz>/stations/<id>/ + INSTRUCOES.txt)
  sudo rsync-hub add <id> <pub>      autoriza com uma chave pública já existente
  sudo rsync-hub add <id> --senha    autoriza por USUÁRIO+SENHA (rsync daemon, porta $RSYNCD_PORT;
                                     mais simples no cliente, mas dados SEM criptografia)
  sudo rsync-hub remove <id>         revoga o acesso da estação (dados preservados)
       rsync-hub list                lista as estações autorizadas
       rsync-hub monitor             modo ao vivo: quem conectou e o que chegou (Ctrl-C sai)
       rsync-hub status              uma leitura do status
       rsync-hub cliente             como configurar uma estação (Linux e Windows)
       rsync-hub                     menu interativo com tudo acima

configuração: gravada pelo install em $CONF_FILE (raiz atual: $BASE);
CARBONARA_ROOT, HUB_USER e RRSYNC no ambiente têm precedência.
o lado CLIENTE fica em collection/station/carbonara-station.sh (Linux) e .ps1 (Windows).
EOF
}

# --- Despacho ----------------------------------------------------------------------
# Aviso de defasagem: rodando uma cópia (ex.: a do repositório) diferente da instalada
# em /usr/local/bin — as chaves apontam para a instalada, então mantenha-as iguais.
# (Não vale para 'serve': roda a cada conexão de estação e não deve poluir o stderr.)
case "${1:-}" in
    serve) : ;;
    *) if [ "$(self_path)" != /usr/local/bin/rsync-hub ] && [ -f /usr/local/bin/rsync-hub ] \
          && ! cmp -s "$(self_path)" /usr/local/bin/rsync-hub 2>/dev/null; then
           echo "aviso: /usr/local/bin/rsync-hub difere desta cópia — atualize com:" >&2
           echo "       sudo install -m 755 $(self_path) /usr/local/bin/rsync-hub" >&2
       fi ;;
esac

case "${1:-}" in
    serve)   shift; serve "$@" ;;
    install) shift; install_host "${1:-}" ;;
    add)     shift
             if [ "${2:-}" = "--senha" ]; then add_station_pw "${1:-}" "${3:-}"
             else add_station "$@"; fi ;;
    remove)  shift; remove_station "$@" ;;
    list)    list_stations ;;
    monitor) monitor ;;
    status)  print_status ;;
    cliente|client|client-help) client_help ;;
    ""|menu) menu ;;
    -h|--help|help) usage ;;
    *) usage; exit 1 ;;
esac
