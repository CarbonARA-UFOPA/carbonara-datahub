# --- Rede do host ------------------------------------------------------------------
# Tudo lido de /proc e de comandos já presentes: nenhum tráfego é gerado e não há teste
# de banda — é a contagem do que JÁ passou pela interface. No hub, o "recebido" é
# essencialmente o que as estações estão enviando.
net_default_iface() {   # a interface com a ROTA PADRÃO (a que tem internet)
    [ -r /proc/net/route ] || return 1
    awk 'NR>1 && $2=="00000000" {print $1; exit}' /proc/net/route
}

net_counters() {   # $1=interface → "bytes_recebidos bytes_enviados" desde o boot
    [ -r /proc/net/dev ] || return 1
    # o ':' pode vir colado no número quando o contador é grande: separa antes
    sed 's/:/ /' /proc/net/dev | awk -v i="$1" '$1==i {print $2, $10; exit}'
}

fmt_bytes() {   # $1=bytes [$2=sufixo, ex.: /s]
    awk -v b="${1:-0}" -v s="${2:-}" 'BEGIN{
        split("B kB MB GB TB PB", u, " "); i=1
        while (b >= 1000 && i < 6) { b /= 1000; i++ }
        if (i == 1) printf "%d %s%s", b, u[i], s; else printf "%.1f %s%s", b, u[i], s
    }'
}

net_sessions() {   # ids das estações COM SESSÃO ABERTA agora (uma por linha)
    # 'serv[e]' evita que o próprio sed apareça como um match no ps.
    ps -eo args= 2>/dev/null | sed -n 's/.*rsync-hub serv[e] \([a-z0-9_]*\).*/\1/p' \
        | sort -u | grep . || true
}

net_conn_since() {   # $1=janela para 'date -d' (ex.: "1 hour ago") → nº de CONNECTs
    [ -s "$LOG" ] || { echo 0; return 0; }
    nc_cut="$(date -u -d "$1" +%FT%TZ 2>/dev/null || true)"
    [ -n "$nc_cut" ] || { echo "?"; return 0; }
    # O carimbo do log é ISO UTC: comparar como TEXTO já ordena certo.
    awk -v c="$nc_cut" '$2=="CONNECT" && $1>=c {n++} END{print n+0}' "$LOG"
}

# $1/$2/$3 = rx, tx e epoch da leitura ANTERIOR (o monitor passa; o status não tem).
print_network() {
    pn_if="$(net_default_iface || true)"
    pn_ip="$(host_addr)"
    if [ -z "$pn_if" ]; then
        echo "  rede: $pn_ip (sem /proc/net/route — taxa indisponível neste sistema)"
        return 0
    fi
    set -- $(net_counters "$pn_if" || echo "")
    pn_rx="${1:-}"; pn_tx="${2:-}"
    printf '  rede: %s (rota padrão) · ip %s' "$pn_if" "$pn_ip"
    if [ -n "$pn_rx" ] && [ -n "${PREV_RX:-}" ] && [ -n "${PREV_T:-}" ]; then
        pn_dt=$(( $(date +%s) - PREV_T ))
        if [ "$pn_dt" -gt 0 ] && [ "$pn_rx" -ge "$PREV_RX" ] 2>/dev/null; then
            printf ' · ↓ %s ↑ %s' \
                "$(fmt_bytes $(( (pn_rx - PREV_RX) / pn_dt )) /s)" \
                "$(fmt_bytes $(( (pn_tx - ${PREV_TX:-0}) / pn_dt )) /s)"
        fi
    fi
    echo
    [ -n "$pn_rx" ] && echo "        total desde o boot: ↓ $(fmt_bytes "$pn_rx") ↑ $(fmt_bytes "$pn_tx")"
    # Portas: 22 é a coleta por chave; 873 só interessa se o modo senha estiver em uso.
    pn_rc=0; port_listening 22 || pn_rc=$?
    case "$pn_rc" in 0) pn_p22="aberta" ;; 2) pn_p22="?" ;; *) pn_p22="NÃO escutando" ;; esac
    pn_p873=""
    if [ -s "$RSYNCD_SECRETS" ]; then
        if port_listening "$RSYNCD_PORT"; then pn_p873=" · $RSYNCD_PORT/rsyncd aberta"
        else pn_p873=" · $RSYNCD_PORT/rsyncd NÃO escutando"; fi
    fi
    echo "        portas: 22/ssh $pn_p22$pn_p873"
    pn_ses="$(net_sessions)"
    if [ -n "$pn_ses" ]; then
        echo "        transferindo agora: $(echo "$pn_ses" | tr '\n' ' ')"
    else
        echo "        transferindo agora: (nenhuma estação conectada)"
    fi
    echo "        conexões: $(net_conn_since '1 hour ago') na última hora · $(net_conn_since '24 hours ago') em 24 h"
    # Fecha a janela para a PRÓXIMA chamada (é assim que o monitor tem taxa a cada ciclo).
    if [ -n "$pn_rx" ]; then PREV_RX="$pn_rx"; PREV_TX="$pn_tx"; PREV_T="$(date +%s)"; fi
    return 0
}

# Uma leitura só (status) não tem janela: amostra por 1 s para conseguir mostrar a taxa.
net_prime_sample() {
    np_if="$(net_default_iface || true)"
    [ -n "$np_if" ] || return 0
    set -- $(net_counters "$np_if" || echo "")
    [ -n "${1:-}" ] || return 0
    PREV_RX="$1"; PREV_TX="$2"; PREV_T="$(date +%s)"
    sleep 1
    return 0
}

# --- Papel 3: status / monitor -----------------------------------------------------
# Estados (bolinha colorida por estação):
#   ● amarelo "Pausada"         — recepção suspensa por 'rsync-hub pause' (tem prioridade)
#   ● roxo    "Recebendo dados" — sessão SSH aberta agora OU arquivos chegando (<60s)
#   ● verde   "Online"          — sinal de vida/atividade dentro da janela da estação
#   ● vermelho"Offline"         — sem sinal além da janela (ou nunca conectou)
#
# A janela é POR ESTAÇÃO: o cliente envia a cada ciclo o arquivo oculto
# .carbonara-status (sinal de vida) declarando o seu tempo de reciclagem
# (interval_min); consideramos Offline após 2 ciclos + 2 min sem sinal. O horário
# usado é o mtime de CHEGADA do arquivo (o envio não preserva o mtime da origem),
# imune a fuso/relógio da estação. Estações sem sinal de vida (clientes antigos)
# caem no limite global RSYNC_HUB_STALE (padrão 1h).
print_status() {
    now="$(date +%s)"
    if [ -t 1 ]; then
        C_ON=$'\033[32m'; C_OFF=$'\033[31m'; C_RX=$'\033[35m'; C_PA=$'\033[33m'; C_0=$'\033[0m'
    else
        C_ON=""; C_OFF=""; C_RX=""; C_PA=""; C_0=""
    fi
    if [ -f "$PAUSE_ALL" ]; then
        echo "  ${C_PA}⏸ RECEPÇÃO PAUSADA para TODAS as estações${C_0} ($(pause_note "$PAUSE_ALL"))"
        echo "  retomar com: sudo rsync-hub resume --todas"
        echo
    fi
    print_network
    echo
    printf '  %-16s %-18s %-22s %-8s %s\n' "ESTAÇÃO" "STATUS" "ÚLTIMO SINAL (local)" "CICLO" "PASTA"
    if [ ! -d "$INCOMING" ]; then echo "(sem pasta $INCOMING — rode 'install')"; return; fi
    found=0
    for d in "$INCOMING"/*/; do
        [ -d "$d" ] || continue
        found=1
        id="$(basename "$d")"
        lastfile="$(find "$d" -type f ! -name '.*' -not -path '*/.*' -printf '%T@\n' 2>/dev/null | sort -nr | head -1)"
        lastfile="${lastfile%.*}"
        lastconn="$(grep " CONNECT $id " "$LOG" 2>/dev/null | tail -1 | awk '{print $1}')"
        lastconn_epoch=""
        [ -n "$lastconn" ] && lastconn_epoch="$(date -u -d "$lastconn" +%s 2>/dev/null || echo '')"
        # Sinal de vida da estação: chegada do .carbonara-status + ciclo declarado.
        hb="$d/.carbonara-status"
        hb_epoch=""; interval=""
        if [ -f "$hb" ]; then
            hb_epoch="$(stat -c %Y "$hb" 2>/dev/null || stat -f %m "$hb" 2>/dev/null || echo '')"
            # tr -d '\r': clientes Windows gravam o heartbeat com CRLF; sem isto o '\r'
            # no fim de "interval_min=15" reprova a validação e a estação cai na janela
            # global de 1h (CICLO some) em vez de 2×ciclo+2min.
            interval="$(sed -n 's/^interval_min=//p' "$hb" 2>/dev/null | tr -d '\r' | head -1)"
            echo "$interval" | grep -Eq '^[0-9]+$' || interval=""
        fi
        act="0"
        [ -n "$lastfile" ] && [ "$lastfile" -gt "$act" ] 2>/dev/null && act="$lastfile"
        [ -n "$lastconn_epoch" ] && [ "$lastconn_epoch" -gt "$act" ] 2>/dev/null && act="$lastconn_epoch"
        [ -n "$hb_epoch" ] && [ "$hb_epoch" -gt "$act" ] 2>/dev/null && act="$hb_epoch"
        # Janela por estação: 2 ciclos + 2 min de folga; sem sinal de vida, o global.
        if [ -n "$interval" ]; then limit=$(( interval * 120 + 120 )); else limit="$STALE_AFTER"; fi
        # Recebendo agora? último evento SSH é um CONNECT sem DISCONNECT depois,
        # ou houve atividade (arquivo/conexão/sinal) nos últimos 60s.
        lastev="$(grep -E " (CONNECT|DISCONNECT) $id " "$LOG" 2>/dev/null | tail -1 | awk '{print $2}')"
        receiving=0
        [ "$lastev" = "CONNECT" ] && receiving=1
        [ "$act" != 0 ] && [ "$((now - act))" -le 60 ] && receiving=1
        if [ "$act" = 0 ]; then when="-"; else when="$(date -d "@$act" '+%F %T' 2>/dev/null || echo "$act")"; fi
        if [ -n "$interval" ]; then cyc="${interval} min"; else cyc="-"; fi
        if is_paused "$id"; then
            # A pausa manda no display: sem recepção a estação não consegue nem mandar
            # o sinal de vida, então "Offline" aqui seria um diagnóstico enganoso.
            dot="${C_PA}●${C_0}"; txt="Pausada"
        elif [ "$receiving" = 1 ]; then
            dot="${C_RX}●${C_0}"; txt="Recebendo dados"
        elif [ "$act" != 0 ] && [ "$((now - act))" -le "$limit" ]; then
            dot="${C_ON}●${C_0}"; txt="Online"
        else
            dot="${C_OFF}●${C_0}"; txt="Offline"
        fi
        printf '%s %-16s %-18s %-22s %-8s %s\n' "$dot" "$id" "$txt" "$when" "$cyc" "$INCOMING/$id"
    done
    [ "$found" = 1 ] || echo "(nenhuma estação com pasta ainda)"
}

# Converte, para EXIBIÇÃO, o 1º campo (carimbo UTC ISO gravado por serve()) de cada
# linha do log para a hora LOCAL do host — o arquivo em si continua em UTC.
fmt_log_local() {
    while IFS= read -r ln; do
        [ -n "$ln" ] || continue
        ts="${ln%% *}"; rest="${ln#* }"
        loc="$(date -d "$ts" '+%F %T' 2>/dev/null || echo "$ts")"
        printf '  %s %s\n' "$loc" "$rest"
    done
}

monitor() {
    trap 'echo; exit 0' INT
    # Janela de medição da rede: a 1ª volta só registra os contadores; da 2ª em diante
    # a taxa sai de graça, sem sleep extra — o próprio intervalo do monitor é a janela.
    PREV_RX=""; PREV_TX=""; PREV_T=""
    while true; do
        clear 2>/dev/null || printf '\033[2J\033[H'
        echo "rsync-hub v$RSYNC_HUB_VERSION — monitor (atualiza a cada ${REFRESH}s · Ctrl-C sai)   $(date '+%F %T')"
        echo
        print_status
        echo
        echo "últimas conexões (chave SSH, hora local):"
        if [ -s "$LOG" ]; then
            tail -n 6 "$LOG" 2>/dev/null | fmt_log_local
        else
            echo "  (sem registros)"
        fi
        if [ -f "$RSYNCD_LOG" ]; then
            echo "últimas conexões (usuário+senha, rsync daemon):"
            tail -n 4 "$RSYNCD_LOG" 2>/dev/null | sed 's/^/  /'
        fi
        sleep "$REFRESH"
    done
}

# --- Menu interativo ---------------------------------------------------------------
menu() {
    while true; do
        echo
        echo "===== rsync-hub — servidor central (host) ====="
        echo " 1) Instalar/preparar este host (guiado)"
        echo " 2) Adicionar estação (guiado)"
        echo " 3) Remover estação"
        echo " 4) Listar estações"
        echo " 5) Status agora"
        echo " 6) PAUSAR a recepção de dados"
        echo " 7) RETOMAR a recepção de dados"
        echo " 8) Diagnosticar acesso das estações"
        echo " 9) Monitorar conexões (ao vivo)"
        echo "10) Como configurar um cliente (estação)"
        echo " 0) Sair"
        printf "opção> "
        read -r op || exit 0
        case "$op" in
            1|2|3|6|7) if ! is_root; then echo "requer root — rode: sudo $(self_path)"; continue; fi ;;
        esac
        case "$op" in
            1) install_host || true ;;
            2) add_station_wizard || true ;;
            3) id="$(ask "id da estação" "")"
               [ -n "$id" ] || { echo "id vazio."; continue; }
               if ask_yn "revogar o acesso de '$id'? (os dados são preservados)" n; then
                   ( remove_station "$id" ) || true
               fi ;;
            4) list_stations ;;
            5) net_prime_sample; print_status ;;
            6) menu_pause ;;
            7) menu_resume ;;
            8) ( diagnose ) || true
               if is_root && ask_yn "tentar reparar as chaves perdidas agora?" n; then
                   ( diagnose --reparar ) || true
               fi ;;
            9) monitor ;;
            10) client_help ;;
            0|q|"") exit 0 ;;
            *) echo "opção inválida" ;;
        esac
    done
}

usage() {
    cat <<EOF
rsync-hub v$RSYNC_HUB_VERSION — coleta CARBONARA por rsync-over-SSH (lado HOST / servidor central)

uso:
  sudo rsync-hub install             instalação GUIADA (pasta raiz + conta + estações)
  sudo rsync-hub install --defaults  instalação sem perguntas (defaults/ambiente)
  sudo rsync-hub add <id>            autoriza uma estação GERANDO a chave aqui no host
                                     (fica em <raiz>/stations/<id>/ + INSTRUCOES.txt)
  sudo rsync-hub add <id> <pub>      autoriza com uma chave pública já existente
  sudo rsync-hub add <id> --senha    autoriza por USUÁRIO+SENHA (rsync daemon, porta $RSYNCD_PORT;
                                     mais simples no cliente, mas dados SEM criptografia)
  sudo rsync-hub pause <id> [motivo] PAUSA a recepção de dados dessa estação (dados e
                                     credenciais preservados; ela reenvia ao retomar)
  sudo rsync-hub pause --todas [mot] PAUSA a recepção de TODAS as estações (manutenção)
  sudo rsync-hub resume <id>         RETOMA a recepção dessa estação
  sudo rsync-hub resume --todas      RETOMA a recepção de todas (pausas individuais
                                     continuam valendo até serem retomadas)
  sudo rsync-hub remove <id>         revoga o acesso da estação (dados preservados)
  sudo rsync-hub purge <id>          EXCLUI a estação DEFINITIVAMENTE: revoga o acesso e
                                     APAGA incoming/archive/quarantine/stations dela
                                     (pede para digitar o id; irreversível)
  sudo rsync-hub move-root <novo>    MIGRA a raiz inteira (dados+chaves+conf) para outra
                                     pasta; a antiga fica intacta como cópia de segurança
       rsync-hub diagnostico         por que as estações não conseguem enviar? (disco,
                                     chaves, home da conta, pausa) — só leitura
  sudo rsync-hub diagnostico --reparar
                                     reautoriza as estações cuja chave pública ainda
                                     está guardada em <raiz>/stations/<id>/
       rsync-hub list                lista as estações autorizadas
       rsync-hub monitor             modo ao vivo: quem conectou e o que chegou (Ctrl-C sai)
       rsync-hub status              uma leitura do status
       rsync-hub cliente             como configurar uma estação (Linux e Windows)
       rsync-hub                     menu interativo com tudo acima

configuração: gravada pelo install em $CONF_FILE (raiz atual: $BASE);
CARBONARA_ROOT, HUB_USER e RRSYNC no ambiente têm precedência.
o lado CLIENTE fica em collection/station/carbonara-station.sh (Linux) e .ps1 (Windows).
EOF
}

# --- Despacho ----------------------------------------------------------------------
# Aviso de defasagem: rodando uma cópia (ex.: a do repositório) diferente da instalada
# em /usr/local/bin — as chaves apontam para a instalada, então mantenha-as iguais.
# (Não vale para 'serve': roda a cada conexão de estação e não deve poluir o stderr.)
case "${1:-}" in
    serve) : ;;
    *) if [ "$(self_path)" != /usr/local/bin/rsync-hub ] && [ -f /usr/local/bin/rsync-hub ] \
          && ! cmp -s "$(self_path)" /usr/local/bin/rsync-hub 2>/dev/null; then
           echo "aviso: /usr/local/bin/rsync-hub difere desta cópia — atualize com:" >&2
           echo "       sudo install -m 755 $(self_path) /usr/local/bin/rsync-hub" >&2
       fi ;;
esac

case "${1:-}" in
    serve)   shift; serve "$@" ;;
    install) shift; install_host "${1:-}" ;;
    add)     shift
             if [ "${2:-}" = "--senha" ]; then add_station_pw "${1:-}" "${3:-}"
             else add_station "$@"; fi ;;
    pause|pausar)             shift; pause_reception "$@" ;;
    resume|retomar|despausar) shift; resume_reception "$@" ;;
    remove)  shift; remove_station "$@" ;;
    purge)   shift; purge_station "$@" ;;
    move-root) shift; move_root "$@" ;;
    diagnostico|diagnostico-acesso|doctor|diagnose) shift; diagnose "${1:-}" ;;
    list)    list_stations ;;
    monitor) monitor ;;
    status)  net_prime_sample; print_status ;;
    cliente|client|client-help) client_help ;;
    ""|menu) menu ;;
    -h|--help|help) usage ;;
    *) usage; exit 1 ;;
esac
