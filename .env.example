# .env.example — copie para .env (ou deixe `sudo ./database/setup-db-host.sh` gerar um
# com senhas aleatórias). O .env é ignorado pelo git: senhas ficam só no servidor.

# Raiz dos dados — a MESMA do rsync-hub (BASE em /etc/rsync-hub.conf). Em dev: ./data
CARBONARA_ROOT=/mnt/data_8tb/carbonara-data-hub

# Diretório do cluster PostgreSQL, no disco de dados (bind mount). Em dev: ./data/pgdata
PG_DATA_DIR=/mnt/data_8tb/carbonara-db/pgdata

# Banco
DB_USER=carbonara
DB_PASSWORD=troque-esta-senha
DB_NAME=carbonara
DB_BIND=127.0.0.1          # 0.0.0.0 só quando o espelho precisar entrar de fora
DB_PORT=5432
REPLICATION_PASSWORD=troque-esta-senha   # papel `replicator` (database/init/04_replication.sh)
# DB_MEM_LIMIT=3g
# PG_SHARED_BUFFERS=1536MB
# PG_EFFECTIVE_CACHE_SIZE=3GB

# API de dados (porta a liberar junto ao STI)
API_PORT=8000
API_KEY_PEPPER=troque-por-um-segredo-longo   # sal global dos hashes das chaves de API

# Ingestão (perfil `ingestao`)
INGEST_POLL_SECONDS=30
# INGEST_MEM_LIMIT=1g
